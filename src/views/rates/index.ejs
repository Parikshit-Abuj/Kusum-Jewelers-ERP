<header class="page-header"><div><p class="eyebrow">Pricing control</p><h1>Daily metal rates</h1></div><a class="button ghost" href="/data-management?resource=rates">Export / archive</a></header>
<section class="rate-tabs"><a class="active" href="#rate-form">Set daily rates</a><a href="#rate-history">Rate history</a></section>
<section id="rate-form" class="panel rate-panel"><div class="panel-heading"><div><h2>Rates for <%= selectedDate %></h2></div><% if (rateInfo.isFallback) { %><span class="pill warning">Using <%= rateInfo.sourceDate %> until saved</span><% } %></div>
  <form method="post" action="/rates"><div class="form-grid four"><label>Rate date *<input name="rateDate" type="date" required value="<%= selectedDate %>"></label><label>22K Gold (₹ / g) *<input name="gold22k" type="number" min="0" step="0.01" required value="<%= rate ? rate.gold22k : '' %>"></label><label>24K Gold (₹ / g) *<input name="gold24k" type="number" min="0" step="0.01" required value="<%= rate ? rate.gold24k : '' %>"></label><label>Silver (₹ / g) *<input name="silver" type="number" min="0" step="0.01" required value="<%= rate ? rate.silver : '' %>"></label></div><label class="notes-label">Rate note (optional)<input name="note" placeholder="e.g. morning wholesale update" value="<%= rate?.note || '' %>"></label><footer class="form-footer"><button class="button" type="submit">Save daily rates</button></footer></form>
</section>
<section id="rate-history" class="panel"><div class="panel-heading"><div><h2>Recent rate history</h2><p>Last 14 saved daily rate sheets.</p></div></div><% if (history.length) { %><div class="table-wrap"><table><thead><tr><th>Date</th><th class="right">22K Gold / g</th><th class="right">24K Gold / g</th><th class="right">Silver / g</th><th>Note</th></tr></thead><tbody><% history.forEach((row) => { %><tr><td><strong><%= formatDateDisplay(row.rateDate) %></strong></td><td class="right"><%= money(row.gold22k) %></td><td class="right"><%= money(row.gold24k) %></td><td class="right"><%= money(row.silver) %></td><td><%= row.note || '—' %></td></tr><% }) %></tbody></table></div><% } else { %><div class="empty-state compact"><span>⌁</span><h3>No rates saved yet</h3><p>Save today’s 22K, 24K and silver rates to start barcode billing.</p></div><% } %></section>
