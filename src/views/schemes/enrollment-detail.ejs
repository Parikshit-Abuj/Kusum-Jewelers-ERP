<%
  const plan = enrollment.schemePlan;
  const cust = enrollment.customer;
  const installments = enrollment.installments || [];
  const paidCount = installments.filter(i => i.status === 'PAID').length;
  const pendingCount = installments.filter(i => i.status === 'PENDING' || i.status === 'OVERDUE').length;
  const progressPct = plan.durationMonths > 0 ? Math.round((paidCount / plan.durationMonths) * 100) : 0;
  const todayStr = dateInput();
  const installmentPayments = (installment) => {
    if (Array.isArray(installment.payments) && installment.payments.length) return installment.payments;
    return Number(installment.paidAmount || 0) > 0 && installment.paymentDate
      ? [{ amount: installment.paidAmount, paymentDate: installment.paymentDate, paymentMethod: installment.paymentMethod }]
      : [];
  };
  const paymentMethodLabel = (method) => ({ CASH: 'Cash', UPI: 'UPI', CARD: 'Card', BANK_TRANSFER: 'Bank transfer' }[method] || method || '—');
%>

<header class="page-header scheme-page-header">
  <div>
    <p class="eyebrow">Scheme Enrollment</p>
    <h1><%= enrollment.enrollmentNumber %></h1>
  </div>
  <div class="header-actions">
    <a class="button ghost" href="/schemes/plans/<%= plan.id %>">← Back to <%= plan.name %></a>
    <a class="button ghost" href="/schemes">All Schemes</a>
  </div>
</header>

<!-- Customer & Scheme info -->
<div class="cashbook-summary scheme-summary-grid">
  <article class="stat-card">
    <span class="stat-label">Customer</span>
    <strong><%= cust.name %></strong>
    <p><%= cust.phone || '—' %></p>
  </article>
  <article class="stat-card">
    <span class="stat-label">Scheme Plan</span>
    <strong><%= plan.name %></strong>
    <p><%= plan.durationMonths %> months · <%- money(plan.monthlyAmount) %>/month</p>
  </article>
  <article class="stat-card accent-gold">
    <span class="stat-label">Total Paid</span>
    <strong class="stat-positive"><%- money(enrollment.totalPaid) %></strong>
    <p><%= paidCount %> of <%= plan.durationMonths %> installments</p>
  </article>
  <article class="stat-card">
    <span class="stat-label">Maturity Value</span>
    <strong><%- money(plan.maturityAmount) %></strong>
    <p>Remaining: <%- money(Math.max(0, Number(plan.durationMonths) * Number(plan.monthlyAmount) - Number(enrollment.totalPaid))) %></p>
  </article>
</div>

<!-- Status & Progress -->
<div class="content-grid scheme-detail-layout scheme-passbook-layout">
  <section class="panel scheme-passbook-panel">
    <div class="panel-heading">
      <div>
        <h2>Installment Schedule</h2>
        <p>
          <span class="pill <%= enrollment.status === 'ACTIVE' ? 'active' : (enrollment.status === 'COMPLETED' ? 'completed' : 'cancelled') %>"><%= enrollment.status %></span>
          &nbsp; <%= formatDateDisplay(enrollment.startDate) %> → <%= formatDateDisplay(enrollment.endDate) %>
        </p>
      </div>
      <% if (enrollment.status === 'ACTIVE') { %>
      <form method="post" action="/schemes/enrollments/<%= enrollment.id %>/cancel" onsubmit="return confirm('Cancel this enrollment? This cannot be undone. Payments already recorded will remain in the cashbook.')">
        <button type="submit" class="button ghost small" style="color:#c0392b;">Cancel Enrollment</button>
      </form>
      <% } %>
    </div>

    <!-- Progress bar -->
    <div class="scheme-progress-bar">
      <div class="scheme-progress-fill" id="schemeProgressFill" style="width: 0;"></div>
      <span class="scheme-progress-label"><%= progressPct %>% Complete</span>
    </div>
    <script>
      (function() {
        var el = document.getElementById('schemeProgressFill');
        if (el) el.style.width = '<%= progressPct %>%';
      })();
    </script>

    <!-- Installment table -->
    <div class="table-wrap scheme-installments-table">
      <table>
        <thead>
          <tr>
            <th style="width:50px;">#</th>
            <th style="width:120px;">Due Date</th>
            <th style="width:100px;">Status</th>
            <th class="right" style="width:130px;">Amount</th>
            <th style="width:120px;">Paid On</th>
            <th style="width:100px;">Method</th>
            <th style="width:130px;"></th>
          </tr>
        </thead>
        <tbody>
          <% installments.forEach(inst => {
            const isOverdue = inst.status === 'PENDING' && inst.dueDate < todayStr;
            const displayStatus = isOverdue ? 'OVERDUE' : inst.status;
            const paidParts = installmentPayments(inst);
            const latestPaidDate = paidParts.map(part => part.paymentDate).filter(Boolean).sort().at(-1) || '';
            const paymentDisplay = paidParts
              .filter(part => part.paymentDate === latestPaidDate)
              .map(part => `${paymentMethodLabel(part.paymentMethod)} ${money(part.amount)}`)
              .join(' + ');
            const paidByMethod = paidParts.reduce((totals, part) => {
              if (part.paymentMethod && Object.hasOwn(totals, part.paymentMethod)) {
                totals[part.paymentMethod] += Number(part.amount || 0);
              }
              return totals;
            }, { CASH: 0, UPI: 0, CARD: 0, BANK_TRANSFER: 0 });
          %>
          <tr class="<%= displayStatus === 'OVERDUE' ? 'row-overdue' : '' %>">
            <td><strong><%= inst.installmentNumber %></strong></td>
            <td><%= inst.dueDate %></td>
            <td>
              <span class="pill <%= displayStatus === 'PAID' ? 'completed' : (displayStatus === 'OVERDUE' ? 'overdue' : 'pending') %>">
                <%= displayStatus %>
              </span>
            </td>
            <td class="right">
              <% if (inst.status === 'PAID') { %>
                <strong><%- money(inst.paidAmount) %></strong>
              <% } else { %>
                <%- money(plan.monthlyAmount) %>
              <% } %>
            </td>
            <td><%= latestPaidDate || '—' %></td>
            <td><%= paymentDisplay || '—' %></td>
            <td>
              <% if ((inst.status === 'PENDING' || displayStatus === 'OVERDUE') && enrollment.status === 'ACTIVE') { %>
              <form method="post" action="/schemes/enrollments/<%= enrollment.id %>/pay" class="scheme-pay-form" data-scheme-split-payment data-monthly-amount="<%= Number(plan.monthlyAmount) %>">
                <input type="hidden" name="installmentId" value="<%= inst.id %>">
                <input type="hidden" name="paymentMethod" value="MIXED">
                <input name="paymentDate" type="date" required value="<%= todayStr %>" title="Payment date" style="width:118px; font-size:12px; padding:3px 6px; border-radius:4px; border:1px solid #d5c9b1;">
                <input name="cashPaid" type="number" min="0" step="0.01" placeholder="Cash" title="Cash amount" style="width:78px; font-size:12px; padding:3px 6px; border-radius:4px; border:1px solid #d5c9b1;">
                <input name="upiPaid" type="number" min="0" step="0.01" placeholder="UPI" title="UPI amount" style="width:78px; font-size:12px; padding:3px 6px; border-radius:4px; border:1px solid #d5c9b1;">
                <input name="cardPaid" type="number" min="0" step="0.01" placeholder="Card" title="Card amount" style="width:78px; font-size:12px; padding:3px 6px; border-radius:4px; border:1px solid #d5c9b1;">
                <input name="bankPaid" type="number" min="0" step="0.01" placeholder="Bank" title="Bank transfer amount" style="width:78px; font-size:12px; padding:3px 6px; border-radius:4px; border:1px solid #d5c9b1;">
                <span data-scheme-split-total style="font-size:12px; white-space:nowrap; color:var(--muted);">Total ₹0.00</span>
                <button type="submit" class="button small" style="padding:3px 10px; font-size:12px;">Record</button>
              </form>
              <% } else if (inst.status === 'PAID' && enrollment.status !== 'CANCELLED') { %>
                <button type="button" class="button ghost small" onclick="document.getElementById('scheme-payment-edit-<%= inst.id %>').showModal()">Edit payment</button>
                <dialog id="scheme-payment-edit-<%= inst.id %>" class="scheme-payment-dialog">
                  <form method="dialog" class="dialog-close-row"><button type="submit" class="icon-button" aria-label="Close">×</button></form>
                  <h3>Edit Month <%= inst.installmentNumber %> payment</h3>
                  <p class="muted">Enter payment parts totaling <strong><%- money(plan.monthlyAmount) %></strong>.</p>
                  <form method="post" action="/schemes/enrollments/<%= enrollment.id %>/installments/<%= inst.id %>/edit-payment" data-scheme-split-payment data-monthly-amount="<%= Number(plan.monthlyAmount) %>" onsubmit="return confirm('Update this scheme payment and its Cashbook entries?')">
                    <input type="hidden" name="paymentMethod" value="MIXED">
                    <label>Payment date<input name="paymentDate" type="date" required value="<%= latestPaidDate || todayStr %>"></label>
                    <div class="scheme-payment-input-grid">
                      <label>Cash<input name="cashPaid" type="number" min="0" step="0.01" value="<%= paidByMethod.CASH || '' %>"></label>
                      <label>UPI<input name="upiPaid" type="number" min="0" step="0.01" value="<%= paidByMethod.UPI || '' %>"></label>
                      <label>Card<input name="cardPaid" type="number" min="0" step="0.01" value="<%= paidByMethod.CARD || '' %>"></label>
                      <label>Bank transfer<input name="bankPaid" type="number" min="0" step="0.01" value="<%= paidByMethod.BANK_TRANSFER || '' %>"></label>
                    </div>
                    <div class="dialog-actions"><span data-scheme-split-total class="muted">Total ₹0.00</span><button type="submit" class="button">Save payment</button></div>
                  </form>
                </dialog>
              <% } %>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <% if (enrollment.notes) { %>
    <div style="margin-top:16px; padding:10px 14px; background:#faf7f2; border-radius:8px; font-size:13px; color:#5a4933;">
      <strong>Notes:</strong> <%= enrollment.notes %>
    </div>
    <% } %>
  </section>
</div>

<script>
document.querySelectorAll('[data-scheme-split-payment]').forEach((form) => {
  const inputs = Array.from(form.querySelectorAll('input[name="cashPaid"], input[name="upiPaid"], input[name="cardPaid"], input[name="bankPaid"]'));
  const total = form.querySelector('[data-scheme-split-total]');
  const monthly = Number(form.dataset.monthlyAmount || 0);
  const updateTotal = () => {
    const value = inputs.reduce((sum, input) => sum + (Number(input.value) || 0), 0);
    const valid = Math.abs(value - monthly) < 0.01;
    total.textContent = `Total ₹${value.toFixed(2)} / ₹${monthly.toFixed(2)}`;
    total.style.color = valid ? 'var(--success, #26734d)' : 'var(--muted)';
  };
  inputs.forEach((input) => input.addEventListener('input', updateTotal));
  form.addEventListener('submit', (event) => {
    const value = inputs.reduce((sum, input) => sum + (Number(input.value) || 0), 0);
    if (Math.abs(value - monthly) >= 0.01) {
      event.preventDefault();
      window.alert(`Enter payment parts totaling ₹${monthly.toFixed(2)}.`);
    }
  });
  updateTotal();
});
</script>
