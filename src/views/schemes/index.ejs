<header class="page-header scheme-page-header">
  <div>
    <p class="eyebrow">Monthly savings plans</p>
    <h1>Schemes</h1>
  </div>
  <div class="header-actions">
    <button type="button" class="button" data-scheme-create-plan-open>+ Create Scheme Plan</button>
  </div>
</header>

<%
  const plans = typeof schemePlans !== 'undefined' && Array.isArray(schemePlans) ? schemePlans : [];
  const stats = typeof schemeStats !== 'undefined' && schemeStats ? schemeStats : { activePlans: 0, totalEnrollments: 0, activeEnrollments: 0, totalCollected: 0 };
%>

<!-- Summary cards -->
<div class="cashbook-summary scheme-summary-grid">
  <article class="stat-card accent-gold">
    <span class="stat-label">Active Plans</span>
    <strong class="stat-positive"><%= stats.activePlans %></strong>
  </article>
  <article class="stat-card">
    <span class="stat-label">Active Enrollments</span>
    <strong><%= stats.activeEnrollments %></strong>
    <p><%= stats.totalEnrollments %> total</p>
  </article>
  <article class="stat-card accent-gold">
    <span class="stat-label">Total Collected</span>
    <strong class="stat-positive"><%- money(stats.totalCollected) %></strong>
  </article>
</div>

<div class="content-grid scheme-layout scheme-overview">

  <!-- Left: Scheme plans list -->
  <section class="panel scheme-plans-panel">
    <div class="panel-heading">
      <div>
        <h2>Scheme Plans</h2>
        <p><%= plans.length %> plan<%= plans.length === 1 ? '' : 's' %> configured</p>
      </div>
      <button type="button" class="button secondary small" data-scheme-create-plan-open>+ New Plan</button>
    </div>

    <% if (plans.length) { %>
    <div class="scheme-plans-list">
      <% plans.forEach(plan => { %>
      <% const termsLocked = (plan._count?.enrollments || 0) > 0; %>
      <div class="scheme-plan-card">
        <div class="scheme-plan-header">
          <div>
            <h3><%= plan.name %></h3>
            <span class="pill <%= plan.isActive ? 'active' : 'inactive' %>"><%= plan.isActive ? 'Active' : 'Inactive' %></span>
          </div>
          <div class="scheme-plan-actions">
            <button type="button" class="button ghost small"
              data-edit-plan-open
              data-plan-id="<%= plan.id %>"
              data-plan-name="<%= plan.name %>"
              data-plan-duration="<%= plan.durationMonths %>"
              data-plan-monthly="<%= Number(plan.monthlyAmount) %>"
              data-plan-maturity="<%= Number(plan.maturityAmount) %>"
              data-plan-desc="<%= plan.description || '' %>"
              data-plan-active="<%= plan.isActive ? '1' : '0' %>"
              data-plan-locked="<%= termsLocked ? '1' : '0' %>">Edit</button>
            <form method="post" action="/schemes/plans/<%= plan.id %>/delete" style="display:inline;" onsubmit="return confirm('Delete this scheme plan permanently? All enrolled customers and their installment records will be removed. Any scheme payments will be reversed from the Cashbook. This cannot be undone.')">
              <button type="submit" class="button ghost small" style="color:#c0392b;">Delete</button>
            </form>
          </div>
        </div>
        <div class="scheme-plan-details">
          <div class="scheme-detail-item">
            <span>Duration</span>
            <strong><%= plan.durationMonths %> months</strong>
          </div>
          <div class="scheme-detail-item">
            <span>Monthly</span>
            <strong><%- money(plan.monthlyAmount) %></strong>
          </div>
          <div class="scheme-detail-item">
            <span>Total scheme amount</span>
            <strong><%- money(plan.maturityAmount) %></strong>
          </div>
          <div class="scheme-detail-item">
            <span>Enrolled Customers</span>
            <strong><%= plan._count?.enrollments || 0 %></strong>
          </div>
        </div>
        <% if (plan.description) { %>
        <p class="scheme-plan-desc"><%= plan.description %></p>
        <% } %>

        <div class="scheme-plan-footer">
          <div class="scheme-plan-primary-actions">
            <a class="button" href="/schemes/plans/<%= plan.id %>">View Scheme & Customers →</a>
            <% if (plan.isActive) { %>
            <a class="button secondary small" href="/schemes/plans/<%= plan.id %>?enroll=1">+ Enroll Customer</a>
            <% } %>
          </div>
          <span class="scheme-enrollment-count"><%= plan._count?.enrollments || 0 %> customer<%= plan._count?.enrollments === 1 ? '' : 's' %> enrolled</span>
        </div>
      </div>
      <% }) %>
    </div>
    <% } else { %>
    <div class="empty-state compact">
      <span>⬡</span>
      <h3>No scheme plans yet</h3>
      <p>Create a savings scheme plan to get started.</p>
      <button type="button" class="button" data-scheme-create-plan-open style="margin-top:12px;">+ Create Scheme Plan</button>
    </div>
    <% } %>
  </section>

</div>

<!-- Create Scheme Plan Modal Popup -->
<div class="modal-overlay scheme-plan-modal" id="schemePlanModal" style="display:none;" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="schemePlanModalTitle">
  <div class="modal-card">
    <header class="modal-header">
      <div>
        <p class="eyebrow" style="margin:0 0 2px;">Savings Plan</p>
        <h2 id="schemePlanModalTitle" style="margin:0;">Create Scheme Plan</h2>
      </div>
      <button class="modal-close-btn" type="button" data-scheme-create-plan-close aria-label="Close modal">✕</button>
    </header>
    <form method="post" action="/schemes/plans/new" id="createSchemePlanForm">
      <div class="modal-body" style="padding: 20px; display: flex; flex-direction: column; gap: 14px;">
        <label>Scheme Name *
          <input name="name" data-uppercase required placeholder="e.g. GOLD SAVINGS 12M" autocomplete="off">
        </label>
        <div class="form-grid two compact-fields">
          <label>Duration (months) *
            <input name="durationMonths" type="number" min="1" max="60" required placeholder="12">
          </label>
          <label>Monthly Installment (₹) *
            <input name="monthlyAmount" type="number" min="1" step="0.01" required placeholder="5000">
          </label>
        </div>
        <label>Total Scheme Amount (₹) *
          <input name="maturityAmount" type="number" min="1" step="0.01" required placeholder="65000">
          <small style="color:#8a7a5a; display:block; margin-top:3px;">Total value at completion; it may include a shop bonus.</small>
        </label>
        <label>Description
          <textarea name="description" data-uppercase rows="3" placeholder="Scheme details, terms, etc."></textarea>
        </label>
      </div>
      <footer class="modal-footer" style="padding: 14px 20px; background: #faf8f5; border-top: 1px solid var(--line); display: flex; justify-content: flex-end; gap: 10px;">
        <button type="button" class="button ghost" data-scheme-create-plan-close>Cancel</button>
        <button class="button" type="submit">Create Plan</button>
      </footer>
    </form>
  </div>
</div>

<!-- Edit Scheme Plan Modal Popup -->
<div class="modal-overlay scheme-edit-modal" id="editSchemePlanModal" style="display:none;" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="editSchemePlanModalTitle">
  <div class="modal-card">
    <header class="modal-header">
      <div>
        <p class="eyebrow" id="editPlanEyebrow" style="margin:0 0 2px;">Scheme Settings</p>
        <h2 id="editSchemePlanModalTitle" style="margin:0;">Edit Scheme Plan</h2>
      </div>
      <button class="modal-close-btn" type="button" data-edit-plan-close aria-label="Close modal">✕</button>
    </header>
    <form method="post" action="" id="editSchemePlanForm">
      <div class="modal-body" style="padding: 20px; display: flex; flex-direction: column; gap: 14px;">
        <div class="pos-field">
          <label>Scheme Plan Name *</label>
          <input name="name" id="editPlanName" data-uppercase required autocomplete="off">
        </div>
        <div class="form-grid two compact-fields">
          <div class="pos-field">
            <label>Duration (months) *</label>
            <input name="durationMonths" id="editPlanDuration" type="number" min="1" max="60" required>
          </div>
          <div class="pos-field">
            <label>Monthly Installment (₹) *</label>
            <input name="monthlyAmount" id="editPlanMonthly" type="number" min="1" step="0.01" required>
          </div>
        </div>
        <div class="pos-field">
          <label>Total Scheme Amount (₹) *</label>
          <input name="maturityAmount" id="editPlanMaturity" type="number" min="1" step="0.01" required>
          <small id="editPlanLockedNote" style="color:#8a7a5a; display:none; margin-top:4px;">Duration and amounts are locked because customers are enrolled in this plan.</small>
        </div>
        <div class="pos-field">
          <label>Description</label>
          <textarea name="description" id="editPlanDesc" data-uppercase rows="3" placeholder="Scheme details, terms, etc."></textarea>
        </div>
        <div class="pos-field">
          <label style="display:flex; align-items:center; gap:8px; font-weight:600; cursor:pointer;">
            <input type="checkbox" name="isActive" id="editPlanActive" style="width:auto; margin:0;">
            Active (accepting new customer enrollments)
          </label>
        </div>
      </div>
      <footer class="modal-footer" style="padding: 14px 20px; background: #faf8f5; border-top: 1px solid var(--line); display: flex; justify-content: flex-end; gap: 10px;">
        <button type="button" class="button ghost" data-edit-plan-close>Cancel</button>
        <button class="button" type="submit">Save Changes</button>
      </footer>
    </form>
  </div>
</div>

<script>
// Create Scheme Plan modal popup
(function initSchemePlanModal() {
  const modal = document.getElementById('schemePlanModal');
  if (!modal) return;

  const openButtons = document.querySelectorAll('[data-scheme-create-plan-open]');
  const closeButtons = modal.querySelectorAll('[data-scheme-create-plan-close]');
  const firstField = modal.querySelector('input[name="name"]');
  let previousFocus = null;

  function openModal() {
    previousFocus = document.activeElement;
    modal.style.display = 'flex';
    modal.setAttribute('aria-hidden', 'false');
    setTimeout(() => firstField?.focus(), 60);
  }

  function closeModal() {
    modal.style.display = 'none';
    modal.setAttribute('aria-hidden', 'true');
    previousFocus?.focus();
  }

  openButtons.forEach(btn => btn.addEventListener('click', openModal));
  closeButtons.forEach(btn => btn.addEventListener('click', closeModal));
  modal.addEventListener('click', (e) => {
    if (e.target === modal) closeModal();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modal.style.display === 'flex') closeModal();
  });
})();

// Edit Scheme Plan modal popup
(function initEditSchemePlanModal() {
  const modal = document.getElementById('editSchemePlanModal');
  if (!modal) return;

  const form = document.getElementById('editSchemePlanForm');
  const eyebrow = document.getElementById('editPlanEyebrow');
  const nameInput = document.getElementById('editPlanName');
  const durationInput = document.getElementById('editPlanDuration');
  const monthlyInput = document.getElementById('editPlanMonthly');
  const maturityInput = document.getElementById('editPlanMaturity');
  const lockedNote = document.getElementById('editPlanLockedNote');
  const descInput = document.getElementById('editPlanDesc');
  const activeInput = document.getElementById('editPlanActive');
  const closeButtons = modal.querySelectorAll('[data-edit-plan-close]');
  let previousFocus = null;

  function openEditModal(btn) {
    const planId = btn.getAttribute('data-plan-id');
    const planName = btn.getAttribute('data-plan-name') || '';
    const duration = btn.getAttribute('data-plan-duration') || '12';
    const monthly = btn.getAttribute('data-plan-monthly') || '0';
    const maturity = btn.getAttribute('data-plan-maturity') || '0';
    const desc = btn.getAttribute('data-plan-desc') || '';
    const isActive = btn.getAttribute('data-plan-active') === '1';
    const isLocked = btn.getAttribute('data-plan-locked') === '1';

    form.action = `/schemes/plans/${planId}/edit`;
    if (eyebrow) eyebrow.textContent = `Scheme Settings · ${planName}`;
    if (nameInput) nameInput.value = planName;
    if (durationInput) {
      durationInput.value = duration;
      durationInput.readOnly = isLocked;
    }
    if (monthlyInput) {
      monthlyInput.value = monthly;
      monthlyInput.readOnly = isLocked;
    }
    if (maturityInput) {
      maturityInput.value = maturity;
      maturityInput.readOnly = isLocked;
    }
    if (lockedNote) lockedNote.style.display = isLocked ? 'block' : 'none';
    if (descInput) descInput.value = desc;
    if (activeInput) activeInput.checked = isActive;

    previousFocus = document.activeElement;
    modal.style.display = 'flex';
    modal.setAttribute('aria-hidden', 'false');
    setTimeout(() => nameInput?.focus(), 60);
  }

  function closeModal() {
    modal.style.display = 'none';
    modal.setAttribute('aria-hidden', 'true');
    previousFocus?.focus();
  }

  document.querySelectorAll('[data-edit-plan-open]').forEach(btn => {
    btn.addEventListener('click', () => openEditModal(btn));
  });
  closeButtons.forEach(btn => btn.addEventListener('click', closeModal));
  modal.addEventListener('click', (e) => {
    if (e.target === modal) closeModal();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modal.style.display === 'flex') closeModal();
  });
})();

// Phone lookup for enrollment
document.querySelectorAll('[data-scheme-phone]').forEach(phoneInput => {
  let timer = null;
  phoneInput.addEventListener('input', () => {
    clearTimeout(timer);
    const digits = (phoneInput.value || '').replace(/\D/g, '');
    if (digits.length >= 10 && digits.length <= 15) {
      timer = setTimeout(async () => {
        try {
          const resp = await fetch(`/api/customers/phone/${encodeURIComponent(digits)}`);
          if (!resp.ok) return;
          const data = await resp.json();
          if (data.found && data.customer) {
            const form = phoneInput.closest('form');
            const nameInput = form?.querySelector('[data-scheme-name]');
            if (nameInput && !nameInput.value) nameInput.value = String(data.customer.name || '').toUpperCase();
          }
        } catch (_) {}
      }, 350);
    }
  });
});
</script>
