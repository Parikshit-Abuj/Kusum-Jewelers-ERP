<header class="page-header"><div><p class="eyebrow">Business registers</p><h1>Reports</h1></div></header>
<% const reportGroups = [
  { title: 'Sales & accounts', reports: [
    ['/reports/sales-register', 'Sales register', 'Invoices, customers and payments.', 'receipt'],
    ['/reports/cashbook-register', 'Cashbook register', 'Money in and out, by payment method.', 'wallet'],
    ['/reports/balance-register', 'Balance register', 'Customer credit and cleared balances.', 'people'],
    ['/urd-purchases', 'URD register', 'Old gold and silver purchases.', 'exchange']
  ] },
  { title: 'Stock & performance', reports: [
    ['/reports/stock', 'Stock report', 'Available pieces, weights and barcodes.', 'diamond'],
    ['/reports/stock-movements', 'Stock movement report', 'Opening, sale and adjustment history.', 'trend'],
    ['/reports/top-selling-items', 'Top selling items', 'Gold and Silver sales performance.', 'chart']
  ] }
]; %>
<div class="report-directory">
  <% reportGroups.forEach(group => { %>
  <section class="report-directory-section" aria-label="<%= group.title %>">
    <h2><%= group.title %></h2>
    <div class="report-menu">
      <% group.reports.forEach(([url, name, description, icon]) => { %>
      <a class="report-menu-card" href="<%= url %>">
        <span class="report-menu-icon"><svg class="ui-icon" aria-hidden="true"><use href="/ui-icons.svg#<%= icon %>"></use></svg></span>
        <span><strong><%= name %></strong><small><%= description %></small></span>
        <b aria-hidden="true">↗</b>
      </a>
      <% }); %>
    </div>
  </section>
  <% }); %>
</div>
