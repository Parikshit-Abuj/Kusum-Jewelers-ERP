<header class="page-header"><div><p class="eyebrow">Business overview</p><h1>Reports</h1><p class="muted">A practical view of sales, receivables and stock by metal.</p></div></header>
<section class="panel report-filter"><form method="get"><label>From<input name="from" type="date" value="<%= dateInput(from) %>"></label><label>To<input name="to" type="date" value="<%= dateInput(to) %>"></label><button class="button secondary" type="submit">Apply dates</button></form></section>
<section class="stats-grid report-stats"><article class="stat-card accent-gold"><span class="stat-label">Sales in period</span><strong><%= money(sales._sum.total) %></strong><p><%= sales._count %> invoice<%= sales._count === 1 ? '' : 's' %> · GST <%= money(sales._sum.gstAmount) %></p></article><article class="stat-card"><span class="stat-label">Amount collected</span><strong><%= money(sales._sum.paid) %></strong><p>Payments recorded against sales</p></article><article class="stat-card"><span class="stat-label">Outstanding receivables</span><strong><%= money(receivables) %></strong><p>Balance across all invoices</p></article></section>
<section class="content-grid reports-grid"><article class="panel"><div class="panel-heading"><div><h2>Top selling items</h2><p>Ranked by billed amount in selected period.</p></div></div><% if (topProducts.length) { %><div class="table-wrap"><table><thead><tr><th>Item</th><th class="right">Units</th><th class="right">Billed</th></tr></thead><tbody><% topProducts.forEach((row) => { %><tr><td><strong><%= row.product?.name || 'Deleted product' %></strong><small><%= row.product?.sku || '' %></small></td><td class="right"><%= row._sum.quantity %></td><td class="right"><strong><%= money(row._sum.lineTotal) %></strong></td></tr><% }) %></tbody></table></div><% } else { %><div class="empty-state compact"><span>▤</span><h3>No sales for this period</h3><p>Try another date range once invoices are recorded.</p></div><% } %></article><article class="panel"><div class="panel-heading"><div><h2>Inventory by metal</h2><p>Pieces and total net weight in current stock.</p></div></div><% if (stockByMetal.length) { %><ul class="metal-report"><% stockByMetal.forEach((row) => { %><li><div><span class="metal-dot <%= row.metal.toLowerCase() %>"></span><strong><%= row.metal %></strong></div><div class="right"><strong><%= row.quantity || 0 %> pieces</strong><small><%= grams(row.netWeight || 0) %> net</small></div></li><% }) %></ul><% } else { %><div class="empty-state compact"><span>◇</span><h3>No inventory yet</h3><p>Stock summaries will appear here.</p></div><% } %></article></section>
