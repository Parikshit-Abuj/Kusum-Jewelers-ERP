<header class="page-header"><div><p class="eyebrow">Service desk</p><h1>Repairs & orders</h1><p class="muted">Receive customer pieces, track work status and hand over confidently.</p></div><div class="header-actions"><a class="button ghost" href="/data-management?resource=repairs">Export / archive</a><a class="button" href="/repairs/new">+ Receive repair</a></div></header>
<section class="panel"><div class="panel-heading"><div><h2>Repair register</h2><p><%= repairs.filter((repair) => repair.status !== 'DELIVERED' && repair.status !== 'CANCELLED').length %> active job<%= repairs.filter((repair) => repair.status !== 'DELIVERED' && repair.status !== 'CANCELLED').length === 1 ? '' : 's' %></p></div></div><% if (repairs.length) { %><div class="table-wrap"><table><thead><tr><th>Job no.</th><th>Customer / item</th><th>Received</th><th>Due</th><th>Charges</th><th>Status</th><th></th></tr></thead><tbody><% repairs.forEach((repair) => { const statusClass = repair.status === 'READY' ? 'success' : repair.status === 'DELIVERED' ? 'neutral' : repair.status === 'CANCELLED' ? 'danger' : 'warning'; %><tr><td><strong><%= repair.repairNumber %></strong><small><%= repair.metal || '—' %><%= repair.grossWeight ? ` · ${grams(repair.grossWeight)}` : '' %></small></td><td><strong><%= repair.customer.name %></strong><small class="truncate"><%= repair.itemDescription %></small></td><td><%= repair.receivedAt.toLocaleDateString('en-IN', { day: '2-digit', month: 'short' }) %></td><td><%= repair.dueDate ? repair.dueDate.toLocaleDateString('en-IN', { day: '2-digit', month: 'short' }) : '—' %></td><td><strong><%= money(repair.finalCharge ?? repair.estimatedCharge) %></strong><small>Advance <%= money(repair.advancePaid) %></small></td><td><span class="pill <%= statusClass %>"><%= repair.status.replace('_', ' ') %></span></td><td><details class="inline-details"><summary class="icon-button" title="Update repair">✎</summary><form method="post" action="/repairs/<%= repair.id %>/status"><label>Status<select name="status"><% ['RECEIVED','IN_PROGRESS','READY','DELIVERED','CANCELLED'].forEach((status) => { %><option value="<%= status %>" <%= repair.status === status ? 'selected' : '' %>><%= status.replace('_', ' ') %></option><% }) %></select></label><label>Final charge (₹)<input name="finalCharge" type="number" min="0" step="0.01" value="<%= repair.finalCharge ?? repair.estimatedCharge %>"></label><button class="button small" type="submit">Update</button></form></details></td></tr><% }) %></tbody></table></div><% } else { %><div class="empty-state"><span>♧</span><h3>No repair jobs received</h3><p>Use the repair desk to issue a job number for customer pieces.</p><a class="button" href="/repairs/new">Receive repair</a></div><% } %></section>
