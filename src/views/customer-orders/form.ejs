<% const current = (typeof order !== 'undefined' && order) || {}; const isEditing = typeof editing !== 'undefined' && Boolean(editing && current.id); const formAction = isEditing ? `/customer-orders/${current.id}/edit` : '/customer-orders'; const customer = current.customer || {}; const supplier = current.supplier || {}; %>
<header class="page-header">
  <div><p class="eyebrow">Made-to-order jewellery</p><h1><%= isEditing ? `Edit ${current.orderNumber}` : 'New customer order' %></h1></div>
  <a class="button ghost" href="/customer-orders">Cancel</a>
</header>
<form class="panel form-panel" method="post" action="<%= formAction %>" data-order-form>
  <section class="form-section"><h2>Customer</h2><div class="form-grid four">
    <input type="hidden" name="customerId" data-order-customer-id value="<%= customer.id || '' %>">
    <label>Customer name *<input name="customerName" autocomplete="off" required data-order-customer placeholder="Search or enter customer" value="<%= customer.name || '' %>"></label>
    <label>Mobile number<input name="customerPhone" inputmode="numeric" maxlength="15" placeholder="Optional" value="<%= customer.phone || '' %>"></label>
    <label>Address<input name="customerAddress" placeholder="Optional" value="<%= customer.address || '' %>"></label>
    <label>PAN<input name="customerPan" maxlength="20" placeholder="Optional" value="<%= customer.panNumber || '' %>"></label>
  </div><div class="supplier-suggestions" data-order-customer-suggestions hidden></div></section>
  <section class="form-section"><h2>Ordered jewellery</h2><div class="form-grid four">
    <label>Order date *<input name="orderDate" type="date" required value="<%= current.orderDate ? dateInput(current.orderDate) : dateInput() %>"></label>
    <label>Expected delivery<input name="dueDate" type="date" value="<%= current.dueDate ? dateInput(current.dueDate) : '' %>"></label>
    <label>Item name *<input name="itemName" data-title-case required placeholder="e.g. Gold Earring" value="<%= current.itemName || '' %>"></label>
    <label>Category<input name="category" data-title-case placeholder="e.g. Earring" value="<%= current.category || '' %>"></label>
    <label>Metal *<select name="metal"><option value="GOLD" <%= current.metal !== 'SILVER' ? 'selected' : '' %>>Gold</option><option value="SILVER" <%= current.metal === 'SILVER' ? 'selected' : '' %>>Silver</option></select></label>
    <label>Purity<input name="purity" placeholder="Write purity, e.g. 22K" value="<%= current.purity || '' %>"></label>
    <label>Pieces *<input name="quantity" type="number" min="1" step="1" required value="<%= current.quantity || 1 %>"></label>
    <label>Target gross wt. (g)<input name="targetGrossWeight" type="number" min="0" step="0.001" placeholder="Optional" value="<%= current.targetGrossWeight || '' %>"></label>
    <label>Target net wt. (g)<input name="targetNetWeight" type="number" min="0" step="0.001" placeholder="Optional" value="<%= current.targetNetWeight || '' %>"></label>
  </div></section>
  <section class="form-section"><h2>Seller / supplier</h2><input type="hidden" name="sellerId" data-order-seller-id value="<%= supplier.id || '' %>"><div class="form-grid four">
    <label>Seller name<input name="sellerName" autocomplete="off" data-order-seller placeholder="Person / supplier given this order" value="<%= supplier.name || '' %>"></label>
    <label>Seller mobile<input name="sellerPhone" inputmode="numeric" maxlength="15" placeholder="Optional" value="<%= supplier.phone || '' %>"></label>
  </div><div class="supplier-suggestions" data-order-seller-suggestions hidden></div></section>
  <section class="form-section"><h2>Amount &amp; advance</h2><div class="form-grid four">
    <label>Quoted amount (₹)<input name="quotedAmount" type="number" min="0" step="0.01" value="<%= current.quotedAmount || 0 %>"></label>
    <label>Recorded advance (₹)<input type="text" value="<%= current.customerAdvance || 0 %>" readonly></label>
    <label>Notes<textarea name="notes" rows="2" placeholder="Design, size, delivery instruction"><%= current.notes || '' %></textarea></label>
  </div><% if (isEditing) { %><p class="muted">Use the order’s Advance action on the register to record another payment.</p><% } else { %>
    <div class="form-grid four"><label>Advance amount (₹)<input name="customerAdvance" type="number" min="0" step="0.01" value="0"></label><label>Advance method<select name="advancePaymentMethod"><option value="CASH">Cash</option><option value="UPI">UPI</option><option value="CARD">Card</option><option value="BANK_TRANSFER">Bank transfer</option></select></label></div>
  <% } %></section>
  <footer class="form-footer"><a class="button ghost" href="/customer-orders">Cancel</a><button class="button" type="submit"><%= isEditing ? 'Save changes' : 'Save customer order' %></button></footer>
</form>
<script>
(() => {
  const form = document.querySelector('[data-order-form]');
  if (!form) return;
  const field = (selector) => form.querySelector(selector);

  function bindSearch(input, box, url, fill, onTyping) {
    if (!input || !box) return;
    let timer;
    let controller;
    input.addEventListener('input', () => {
      onTyping?.();
      clearTimeout(timer);
      const term = input.value.trim();
      if (term.length < 2) { box.hidden = true; return; }
      timer = setTimeout(async () => {
        controller?.abort(); controller = new AbortController();
        try {
          const response = await fetch(url + encodeURIComponent(term), { signal: controller.signal });
          const data = await response.json();
          const rows = data.customers || data.suppliers || [];
          box.replaceChildren(...rows.map((row) => {
            const button = document.createElement('button');
            button.type = 'button';
            button.textContent = `${row.name}${row.phone ? ' · ' + row.phone : ''}`;
            button.addEventListener('click', () => { fill(row); box.hidden = true; });
            return button;
          }));
          box.hidden = !rows.length;
        } catch (error) { if (error.name !== 'AbortError') box.hidden = true; }
      }, 220);
    });
  }

  const customer = field('[data-order-customer]');
  const customerPhone = field('[name=customerPhone]');
  const customerBox = field('[data-order-customer-suggestions]');
  const customerId = field('[data-order-customer-id]');
  const fillCustomer = (row) => {
    customerId.value = row.id || '';
    customer.value = row.name || '';
    customerPhone.value = row.phone || '';
    field('[name=customerAddress]').value = row.address || '';
    field('[name=customerPan]').value = row.panNumber || '';
  };
  bindSearch(customer, customerBox, '/api/customers/search?q=', fillCustomer, () => { customerId.value = ''; });

  async function lookupCustomerByPhone() {
    const phone = String(customerPhone?.value || '').replace(/\D/g, '').slice(0, 15);
    if (customerPhone) customerPhone.value = phone;
    if (!phone || phone.length < 10) { if (customerId) customerId.value = ''; return; }
    try {
      const response = await fetch('/api/customers/phone/' + encodeURIComponent(phone));
      const data = await response.json();
      if (!response.ok) throw new Error(data.error || 'Could not look up this customer.');
      if (data.found) fillCustomer(data.customer); else customerId.value = '';
    } catch (_) { customerId.value = ''; }
  }
  let customerPhoneTimer;
  customerPhone?.addEventListener('input', () => {
    customerId.value = '';
    clearTimeout(customerPhoneTimer);
    const digits = String(customerPhone.value || '').replace(/\D/g, '');
    if (digits.length >= 10) customerPhoneTimer = setTimeout(lookupCustomerByPhone, 300);
  });
  customerPhone?.addEventListener('blur', lookupCustomerByPhone);
  customerPhone?.addEventListener('keydown', async (event) => {
    if (event.key !== 'Enter' || event.isComposing) return;
    event.preventDefault(); clearTimeout(customerPhoneTimer); await lookupCustomerByPhone(); customer?.focus();
  });

  const seller = field('[data-order-seller]');
  const sellerPhone = field('[name=sellerPhone]');
  const sellerBox = field('[data-order-seller-suggestions]');
  const sellerId = field('[data-order-seller-id]');
  const fillSeller = (row) => {
    sellerId.value = row.id || '';
    seller.value = row.name || '';
    sellerPhone.value = row.phone || '';
  };
  bindSearch(seller, sellerBox, '/api/suppliers/search?q=', fillSeller, () => { sellerId.value = ''; });

  async function lookupSellerByPhone() {
    const phone = String(sellerPhone?.value || '').replace(/\D/g, '').slice(0, 15);
    if (sellerPhone) sellerPhone.value = phone;
    if (!phone || phone.length < 10) { if (sellerId) sellerId.value = ''; return; }
    try {
      const response = await fetch('/api/suppliers/phone/' + encodeURIComponent(phone));
      const data = await response.json();
      if (!response.ok) throw new Error(data.error || 'Could not look up this supplier.');
      if (data.found) fillSeller(data.supplier); else sellerId.value = '';
    } catch (_) { sellerId.value = ''; }
  }
  let sellerPhoneTimer;
  sellerPhone?.addEventListener('input', () => {
    sellerId.value = '';
    clearTimeout(sellerPhoneTimer);
    const digits = String(sellerPhone.value || '').replace(/\D/g, '');
    if (digits.length >= 10) sellerPhoneTimer = setTimeout(lookupSellerByPhone, 300);
  });
  sellerPhone?.addEventListener('blur', lookupSellerByPhone);
  sellerPhone?.addEventListener('keydown', async (event) => {
    if (event.key !== 'Enter' || event.isComposing) return;
    event.preventDefault(); clearTimeout(sellerPhoneTimer); await lookupSellerByPhone(); seller?.focus();
  });
})();
</script>
