<header class="page-header"><div><p class="eyebrow">Made-to-order jewellery</p><h1>New Customer Order</h1></div><a class="button ghost" href="/customer-orders">Cancel</a></header>
<form class="panel form-panel" method="post" action="/customer-orders" data-order-form>
  <section class="form-section"><h2>Customer</h2><div class="form-grid four"><input type="hidden" name="customerId" data-order-customer-id><label>Customer name *<input name="customerName" autocomplete="off" required data-order-customer placeholder="Search or enter customer"></label><label>Mobile number<input name="customerPhone" inputmode="numeric" maxlength="15" placeholder="Optional"></label><label>Address<input name="customerAddress" placeholder="Optional"></label><label>PAN<input name="customerPan" maxlength="20" placeholder="Optional"></label></div><div class="supplier-suggestions" data-order-customer-suggestions hidden></div></section>
  <section class="form-section"><h2>Ordered jewellery</h2><div class="form-grid four"><label>Order date *<input name="orderDate" type="date" required value="<%=dateInput()%>"></label><label>Expected delivery<input name="dueDate" type="date"></label><label>Item name *<input name="itemName" data-title-case required placeholder="e.g. Gold Earring"></label><label>Category<input name="category" data-title-case placeholder="e.g. Earring"></label><label>Metal *<select name="metal"><option value="GOLD">Gold</option><option value="SILVER">Silver</option></select></label><label>Purity<input name="purity" placeholder="Write purity, e.g. 22K"></label><label>Pieces *<input name="quantity" type="number" min="1" step="1" required value="1"></label><label>Target gross wt. (g)<input name="targetGrossWeight" type="number" min="0" step="0.001" placeholder="Optional"></label><label>Target net wt. (g)<input name="targetNetWeight" type="number" min="0" step="0.001" placeholder="Optional"></label></div></section>
  <section class="form-section"><h2>Seller / supplier</h2><input type="hidden" name="sellerId" data-order-seller-id><div class="form-grid four"><label>Seller name<input name="sellerName" autocomplete="off" data-order-seller placeholder="Person / supplier given this order"></label><label>Seller mobile<input name="sellerPhone" inputmode="numeric" maxlength="15" placeholder="Optional"></label></div><div class="supplier-suggestions" data-order-seller-suggestions hidden></div></section>
  <section class="form-section"><h2>Amount & advance</h2><div class="form-grid four"><label>Quoted amount (₹)<input name="quotedAmount" type="number" min="0" step="0.01" value="0"></label><label>Customer advance (₹)<input name="customerAdvance" type="number" min="0" step="0.01" value="0"></label><label>Advance method<select name="advancePaymentMethod"><option value="CASH">Cash</option><option value="UPI">UPI</option><option value="CARD">Card</option><option value="BANK_TRANSFER">Bank transfer</option></select></label><label>Notes<textarea name="notes" rows="2" placeholder="Design, size, delivery instruction"></textarea></label></div></section>
  <footer class="form-footer"><a class="button ghost" href="/customer-orders">Cancel</a><button class="button" type="submit">Save customer order</button></footer>
</form>
<script>(()=>{const f=document.querySelector('[data-order-form]');if(!f)return;function bind(input,box,url,fill,onTyping){let timer,controller;input.addEventListener('input',()=>{onTyping?.();clearTimeout(timer);const q=input.value.trim();if(q.length<2){box.hidden=true;return}timer=setTimeout(async()=>{controller?.abort();controller=new AbortController();try{const r=await fetch(url+encodeURIComponent(q),{signal:controller.signal});const data=await r.json();const list=data.customers||data.suppliers||[];box.replaceChildren(...list.map(row=>{const b=document.createElement('button');b.type='button';b.textContent=`${row.name}${row.phone?' · '+row.phone:''}`;b.onclick=()=>{fill(row);box.hidden=true};return b}));box.hidden=!list.length}catch(e){if(e.name!=='AbortError')box.hidden=true}},220)})};const customer=f.querySelector('[data-order-customer]'),customerBox=f.querySelector('[data-order-customer-suggestions]'),customerId=f.querySelector('[data-order-customer-id]');bind(customer,customerBox,'/api/customers/search?q=',row=>{customerId.value=row.id;customer.value=row.name;f.querySelector('[name=customerPhone]').value=row.phone||''},()=>{customerId.value=''});const seller=f.querySelector('[data-order-seller]'),sellerBox=f.querySelector('[data-order-seller-suggestions]'),sellerId=f.querySelector('[data-order-seller-id]');bind(seller,sellerBox,'/api/suppliers/search?q=',row=>{sellerId.value=row.id;seller.value=row.name;f.querySelector('[name=sellerPhone]').value=row.phone||''},()=>{sellerId.value=''})})();</script>
