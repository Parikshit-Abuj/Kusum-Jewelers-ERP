<header class="page-header"><div><p class="eyebrow">Billing desk</p><h1>Sales</h1><p class="muted">Invoices automatically reduce piece-wise stock.</p></div><div class="header-actions"><a class="button ghost" href="/data-management?resource=sales">Export / archive</a><a class="button" href="/sales/new">+ Create invoice</a></div></header>
<section class="panel"><div class="panel-heading"><div><h2>Recent invoices</h2><p>Most recent 100 counter sales.</p></div></div>
  <% if (sales.length) { %>
    <div class="table-wrap"><table><thead><tr><th>Invoice</th><th>Customer</th><th>Date</th><th>Items</th><th>Payment</th><th class="right">Invoice total</th><th class="right">Net payable</th><th></th></tr></thead><tbody>
      <% sales.forEach((sale) => { const netPayable = Number(sale.total) - Number(sale.urdOffset); %>
        <tr><td><strong><%= sale.invoiceNumber %></strong></td><td><%= sale.customer?.name || 'Walk-in customer' %></td><td><%= sale.saleDate.toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) %></td><td><%= sale._count.items %></td><td><span class="pill neutral"><%= sale.paymentMethod.replace('_', ' ') %></span><% if (Number(sale.urdOffset) > 0) { %><small>URD adjusted <%= money(sale.urdOffset) %></small><% } %><% if (Number(sale.balance) > 0) { %><small class="danger-text">Due <%= money(sale.balance) %></small><% } %></td><td class="right"><strong><%= money(sale.total) %></strong></td><td class="right"><strong><%= money(netPayable) %></strong></td><td><a class="icon-button" href="/sales/<%= sale.id %>" title="Open invoice">→</a></td></tr>
      <% }) %>
    </tbody></table></div>
  <% } else { %>
    <div class="empty-state"><span>₹</span><h3>No invoices yet</h3><p>Start your first sale - stock will update automatically.</p><a class="button" href="/sales/new">Create invoice</a></div>
  <% } %>
</section>
