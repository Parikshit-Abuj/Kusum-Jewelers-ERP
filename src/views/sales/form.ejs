<style>
  /* ── Ultra Clean Professional POS Billing Desk ─────────────────── */
  .billing-wrapper {
    display: flex;
    flex-direction: column;
    gap: 16px;
    width: 100%;
    box-sizing: border-box;
  }

  .billing-header-strip {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    background: #ffffff;
    border: 1px solid #e2d9c8;
    border-radius: 12px;
    padding: 12px 18px;
    box-shadow: 0 2px 10px rgba(60, 45, 20, 0.04);
  }

  .billing-title-area {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .billing-badge-icon {
    width: 36px;
    height: 36px;
    border-radius: 8px;
    background: linear-gradient(135deg, #f0c164, #9d6512);
    color: #2d1c06;
    display: grid;
    place-items: center;
    font-size: 15px;
    font-weight: 800;
    box-shadow: 0 2px 8px rgba(180, 122, 33, 0.2);
  }

  .billing-title-text h1 {
    font-size: 19px;
    font-weight: 800;
    color: #1a1612;
    margin: 0;
    letter-spacing: -.01em;
  }

  .billing-title-text p {
    font-size: 11.5px;
    color: #7d7265;
    margin: 0;
  }

  .billing-rate-pills {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .rate-tag {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 5px 11px;
    border-radius: 20px;
    background: #faf7f2;
    border: 1px solid #ebd9c4;
    font-size: 11.5px;
    color: #4a3e31;
    font-weight: 600;
  }

  .rate-tag strong {
    color: #9d6512;
    font-weight: 750;
  }

  /* Main Transaction Grid */
  .transaction-layout.barcode-sale {
    display: grid !important;
    grid-template-columns: 1fr 350px !important;
    gap: 18px !important;
    align-items: start !important;
  }

  @media (max-width: 1100px) {
    .transaction-layout.barcode-sale {
      grid-template-columns: 1fr !important;
    }
  }

  /* Card Containers */
  .pos-card {
    background: #ffffff;
    border: 1px solid #e5ddcc;
    border-radius: 12px;
    padding: 16px 18px;
    box-shadow: 0 2px 10px rgba(60, 45, 20, 0.03);
    margin-bottom: 14px;
    box-sizing: border-box;
  }

  .pos-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 12px;
    padding-bottom: 9px;
    border-bottom: 1px solid #f2ede4;
  }

  .pos-card-title {
    font-size: 13.5px;
    font-weight: 800;
    color: #2b2319;
    margin: 0;
  }

  /* Top 3-Column Info */
  .pos-grid-3 {
    display: grid;
    grid-template-columns: 1fr 1fr 1.6fr;
    gap: 10px;
    margin-bottom: 10px;
  }

  @media (max-width: 700px) {
    .pos-grid-3 { grid-template-columns: 1fr; }
  }

  .pos-field {
    display: flex;
    flex-direction: column;
    gap: 3px;
    margin: 0;
  }

  .pos-field label {
    font-size: 10.5px;
    font-weight: 750;
    color: #63584c;
    text-transform: uppercase;
    letter-spacing: .03em;
    margin: 0;
  }

  .pos-field input, .pos-field select {
    padding: 8px 11px;
    border: 1.5px solid #ded5c5;
    border-radius: 8px;
    background: #ffffff;
    font-size: 13px;
    color: #1a1612;
    font-family: inherit;
    font-weight: 550;
    transition: border-color .15s, box-shadow .15s;
    box-sizing: border-box;
    width: 100%;
    margin: 0;
  }

  .pos-field input:focus, .pos-field select:focus {
    outline: none;
    border-color: #c9a044;
    box-shadow: 0 0 0 2.5px rgba(201, 160, 68, 0.15);
  }

  /* Customer State Boxes */
  .cust-status-badge {
    padding: 8px 12px;
    border-radius: 8px;
    font-size: 11.5px;
    background: #fdfbf7;
    border: 1px dashed #ded4c1;
    color: #706557;
    margin-bottom: 8px;
  }

  .cust-existing-box {
    background: #f3faf5;
    border: 1.5px solid #b7e4c7;
    border-radius: 9px;
    padding: 10px 14px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 10px;
  }

  .cust-existing-info strong {
    color: #145a32;
    font-size: 13px;
    display: block;
  }

  .cust-existing-info span {
    color: #2e7d32;
    font-size: 11.5px;
  }

  .cust-new-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 8px;
    background: #fffdf9;
    border: 1.5px solid #ebd9c4;
    border-radius: 9px;
    padding: 10px 12px;
    margin-bottom: 10px;
  }

  /* ── Line Items Scoped Overrides ── */
  .barcode-sale .barcode-lines {
    padding: 0 !important;
    display: flex !important;
    flex-direction: column !important;
    gap: 12px !important;
    margin-bottom: 14px !important;
  }

  .barcode-sale .barcode-line {
    display: block !important;
    background: #ffffff !important;
    border: 1.5px solid #e0d6c3 !important;
    border-radius: 11px !important;
    padding: 14px 16px !important;
    box-shadow: 0 2px 8px rgba(60, 45, 20, 0.03) !important;
    margin-bottom: 12px !important;
    position: relative !important;
    box-sizing: border-box !important;
  }

  .barcode-sale .barcode-line:focus-within {
    border-color: #c9a044 !important;
    box-shadow: 0 0 0 1px #c9a044 !important;
  }

  /* Line Header Row */
  .barcode-sale .line-header-row {
    display: flex !important;
    align-items: center !important;
    gap: 10px !important;
    margin-bottom: 12px !important;
  }

  .barcode-sale .line-number {
    width: 24px !important;
    height: 24px !important;
    border-radius: 50% !important;
    background: #f0ebe0 !important;
    color: #7d6b53 !important;
    font-size: 11.5px !important;
    font-weight: 800 !important;
    display: grid !important;
    place-items: center !important;
    flex-shrink: 0 !important;
    padding: 0 !important;
    margin: 0 !important;
    grid-row: auto !important;
    grid-column: auto !important;
  }

  .barcode-sale .barcode-field-wrap {
    flex: 0 0 190px !important;
    display: flex !important;
    flex-direction: column !important;
    gap: 3px !important;
    margin: 0 !important;
  }

  .barcode-sale .barcode-field-wrap label {
    font-size: 10px !important;
    font-weight: 750 !important;
    color: #736758 !important;
    text-transform: uppercase !important;
    letter-spacing: .03em !important;
    margin: 0 !important;
  }

  .barcode-sale .barcode-field-wrap input {
    padding: 8px 10px !important;
    border: 1.5px solid #cbb898 !important;
    border-radius: 7px !important;
    font-family: 'Courier New', monospace !important;
    font-size: 13.5px !important;
    font-weight: 750 !important;
    color: #1a1612 !important;
    background: #fffdfa !important;
    margin: 0 !important;
    width: 100% !important;
    box-sizing: border-box !important;
  }

  .barcode-sale .scanned-item {
    flex: 1 !important;
    min-width: 0 !important;
    background: #faf6ee !important;
    border: 1px solid #ebd9c4 !important;
    border-radius: 7px !important;
    padding: 6px 12px !important;
    min-height: 40px !important;
    display: flex !important;
    flex-direction: column !important;
    justify-content: center !important;
    grid-row: auto !important;
    grid-column: auto !important;
    margin: 0 !important;
  }

  .barcode-sale .scanned-item strong {
    font-size: 12.5px !important;
    color: #2b2319 !important;
    white-space: nowrap !important;
    overflow: hidden !important;
    text-overflow: ellipsis !important;
  }

  .barcode-sale .scanned-item small {
    font-size: 11px !important;
    color: #7d705f !important;
    white-space: nowrap !important;
    overflow: hidden !important;
    text-overflow: ellipsis !important;
  }

  .barcode-sale [data-remove-row] {
    flex-shrink: 0 !important;
    width: 26px !important;
    height: 26px !important;
    border-radius: 6px !important;
    border: 1px solid #f6d1d1 !important;
    background: #fdf4f4 !important;
    color: #c82333 !important;
    font-size: 15px !important;
    display: grid !important;
    place-items: center !important;
    cursor: pointer !important;
    transition: all .15s !important;
    padding: 0 !important;
    margin: 0 !important;
    grid-row: auto !important;
    grid-column: auto !important;
  }

  .barcode-sale [data-remove-row]:hover {
    background: #dc3545 !important;
    color: #fff !important;
  }

  /* 2-Tier Structured Input Grid */
  .barcode-sale .line-fields-grid {
    display: grid !important;
    grid-template-columns: 1.1fr 1.1fr 1fr 1.1fr 1.4fr !important;
    gap: 8px !important;
    margin-bottom: 8px !important;
  }

  .barcode-sale .line-specs-grid {
    display: grid !important;
    grid-template-columns: 65px 1fr 1.1fr 1.1fr !important;
    gap: 8px !important;
    background: #fdfbf7 !important;
    border: 1px solid #f0e8db !important;
    border-radius: 7px !important;
    padding: 6px 10px !important;
  }

  @media (max-width: 800px) {
    .barcode-sale .line-fields-grid { grid-template-columns: 1fr 1fr !important; }
    .barcode-sale .line-specs-grid { grid-template-columns: 1fr 1fr !important; }
  }

  .barcode-sale .input-unit {
    display: flex !important;
    flex-direction: column !important;
    gap: 3px !important;
    margin: 0 !important;
  }

  .barcode-sale .input-unit label {
    font-size: 9.5px !important;
    font-weight: 750 !important;
    color: #6d6153 !important;
    text-transform: uppercase !important;
    letter-spacing: .03em !important;
    margin: 0 !important;
  }

  .barcode-sale .input-unit input,
  .barcode-sale .input-unit select {
    padding: 7px 8px !important;
    border: 1.5px solid #ded5c5 !important;
    border-radius: 7px !important;
    font-size: 12.5px !important;
    color: #1a1612 !important;
    background: #ffffff !important;
    font-family: inherit !important;
    font-weight: 600 !important;
    box-sizing: border-box !important;
    width: 100% !important;
    margin: 0 !important;
  }

  .barcode-sale .input-unit input:focus,
  .barcode-sale .input-unit select:focus {
    outline: none !important;
    border-color: #c9a044 !important;
    box-shadow: 0 0 0 2px rgba(201, 160, 68, 0.15) !important;
  }

  .barcode-sale .input-unit input[data-taxable-amount] {
    background: #fff9ea !important;
    border-color: #d8be8a !important;
    font-weight: 800 !important;
    color: #9d6512 !important;
  }

  .barcode-sale .line-help {
    display: block !important;
    font-size: 11px !important;
    color: #8c7f6f !important;
    margin-top: 5px !important;
    grid-row: auto !important;
    grid-column: auto !important;
    padding: 0 !important;
  }

  /* URD Box */
  .urd-settlement {
    background: #faf7f1;
    border: 1.5px solid #ebd9c4;
    border-radius: 10px;
    padding: 12px 14px;
  }

  .urd-toggle {
    display: flex;
    align-items: center;
    gap: 9px;
    cursor: pointer;
    margin: 0;
  }

  .urd-toggle input[type="checkbox"] {
    width: 17px;
    height: 17px;
    accent-color: #b47a21;
    cursor: pointer;
  }

  .urd-toggle span strong {
    font-size: 12.5px;
    color: #2b2319;
    display: block;
  }

  .urd-toggle span small {
    font-size: 11px;
    color: #7d705f;
  }

  .urd-settlement-fields {
    margin-top: 10px;
    padding-top: 10px;
    border-top: 1px dashed #dfd4c1;
  }

  .urd-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(105px, 1fr));
    gap: 8px;
  }

  /* Right Sidebar */
  .transaction-summary {
    background: #ffffff;
    border: 1.5px solid #dfd4c5;
    border-radius: 14px;
    padding: 18px 20px;
    box-shadow: 0 3px 16px rgba(60, 45, 20, 0.05);
    position: sticky;
    top: 14px;
    box-sizing: border-box;
  }

  .summary-heading {
    font-size: 14.5px;
    font-weight: 800;
    color: #1a1612;
    margin: 0 0 12px 0;
    padding-bottom: 8px;
    border-bottom: 1px solid #f0ebe2;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .summary-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 12.5px;
    color: #5c5245;
    margin-bottom: 8px;
  }

  .summary-row strong {
    font-size: 13.5px;
    color: #1a1612;
    font-weight: 700;
  }

  .summary-input-wrap {
    display: flex;
    flex-direction: column;
    gap: 3px;
    margin-bottom: 9px;
  }

  .summary-input-wrap label {
    font-size: 10px;
    font-weight: 750;
    color: #63584c;
    text-transform: uppercase;
  }

  .summary-input-wrap input, .summary-input-wrap select {
    padding: 8px 11px;
    border: 1.5px solid #ded5c5;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 650;
    color: #1a1612;
    box-sizing: border-box;
    width: 100%;
  }

  .summary-total-box {
    background: #fffdf9;
    border: 1.5px solid #ebd9c4;
    border-radius: 9px;
    padding: 9px 12px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin: 9px 0;
  }

  .summary-total-box span {
    font-size: 12px;
    font-weight: 700;
    color: #705e46;
  }

  .summary-total-box strong {
    font-size: 16px;
    font-weight: 800;
    color: #2b2319;
  }

  .net-payable-box {
    background: #fff8eb;
    border: 1.5px solid #dfa437;
    border-radius: 10px;
    padding: 11px 13px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin: 9px 0 12px;
  }

  .net-payable-box span {
    font-size: 11.5px;
    font-weight: 800;
    color: #7c4f0b;
    text-transform: uppercase;
    letter-spacing: .03em;
  }

  .net-payable-box strong {
    font-size: 20px;
    font-weight: 900;
    color: #b47a21;
  }

  .due-pill {
    background: #fdf3f3;
    border: 1px solid #f7d2d2;
    border-radius: 7px;
    padding: 6px 10px;
    margin: 5px 0 10px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 12px;
    color: #9c302b;
  }

  .due-pill strong {
    color: #dc3545;
    font-size: 13px;
  }

  .btn-submit-bill {
    width: 100%;
    padding: 13px;
    background: linear-gradient(135deg, #d4a23c, #a37518);
    color: #ffffff;
    border: none;
    border-radius: 10px;
    font-size: 14px;
    font-weight: 800;
    letter-spacing: .02em;
    cursor: pointer;
    box-shadow: 0 4px 15px rgba(163, 117, 24, 0.25);
    transition: transform .15s, box-shadow .15s;
    margin-top: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .btn-submit-bill:hover {
    transform: translateY(-1px);
    box-shadow: 0 6px 20px rgba(163, 117, 24, 0.35);
  }
</style>

<div class="billing-wrapper">
  <!-- Top Bar & Live Rates -->
  <header class="billing-header-strip no-print">
    <div class="billing-title-area">
      <div class="billing-badge-icon">KJ</div>
      <div class="billing-title-text">
        <h1>Create Tax Invoice</h1>
        <p>Scan barcode, confirm weight, and generate official GST invoice</p>
      </div>
    </div>

    <div class="billing-rate-pills">
      <% if (!rateInfo.rate) { %>
        <span class="rate-tag" style="border-color:#f5c2c7; background:#fff5f5; color:#842029;">
          Rates not set · <a href="/rates" style="color:#842029; font-weight:750;">Set Daily Rates →</a>
        </span>
      <% } else { %>
        <span class="rate-tag">
          22K Gold: <strong><%- money(rateInfo.rate.gold22k) %>/g</strong>
        </span>
        <span class="rate-tag">
          24K Gold: <strong><%- money(rateInfo.rate.gold24k) %>/g</strong>
        </span>
        <span class="rate-tag">
          Silver: <strong><%- money(rateInfo.rate.silver) %>/g</strong>
        </span>
        <a class="button ghost small" href="/rates" style="border-radius:20px; font-size:11px; padding:3px 8px;">Update →</a>
      <% } %>
      <a class="button ghost small" href="/sales" style="border-radius:20px; font-size:11px; padding:3px 8px;">Cancel</a>
    </div>
  </header>

  <!-- POS Form -->
  <form class="transaction-layout barcode-sale" method="post" action="/sales" data-barcode-sale>

    <!-- Left Main Area -->
    <section class="transaction-main">
      <!-- 1. Customer & Invoice Details -->
      <div class="pos-card">
        <div class="pos-card-header">
          <h2 class="pos-card-title">Customer & Invoice Information</h2>
        </div>

        <div class="pos-grid-3">
          <div class="pos-field">
            <label>Invoice Number</label>
            <input name="invoiceNumber" readonly value="<%= typeof invoiceNumber !== 'undefined' ? invoiceNumber : '' %>" placeholder="Assigned when saved" style="font-family:'Courier New',monospace; font-weight:750; background:#fbf9f5;">
          </div>
          <div class="pos-field">
            <label>Billing Date</label>
            <input name="saleDate" type="date" value="<%= dateInput() %>" data-sale-date required>
          </div>
          <div class="pos-field">
            <label>Customer Mobile Number *</label>
            <input name="customerPhone" inputmode="numeric" autocomplete="tel" maxlength="15" required placeholder="Type 10-digit mobile number" data-customer-phone autofocus>
          </div>
        </div>

        <!-- Customer Lookup Component -->
        <section class="customer-lookup" data-customer-lookup>
          <input type="hidden" name="customerId" data-customer-id>
          <div class="cust-status-badge" data-customer-status>
            Enter customer mobile number above to load their ledger or register a new customer.
          </div>

          <!-- Existing Customer Found -->
          <div class="cust-existing-box" data-existing-customer hidden>
            <div class="cust-existing-info">
              <strong data-existing-name></strong>
              <span data-existing-details></span>
            </div>
            <div style="display:flex; align-items:center; gap:8px;">
              <label style="margin:0; font-size:10.5px; display:inline-flex; align-items:center; gap:4px; font-weight:700; color:#2e7d32;">
                <span>PAN (opt):</span>
                <input name="existingCustomerPan" data-existing-pan placeholder="e.g. ABCDE1234F" maxlength="10" autocomplete="off" style="padding:4px 7px; font-size:11.5px; width:110px; text-transform:uppercase; border:1px solid #a3d9b8; border-radius:6px;">
              </label>
              <a class="button ghost small" data-existing-ledger href="#" hidden style="background:#fff; border-color:#a3d9b8; color:#145a32; padding:3px 8px; font-size:11px;">Open Ledger →</a>
            </div>
          </div>

          <!-- New Customer Entry Fields -->
          <div class="cust-new-grid" data-new-customer-fields hidden>
            <div class="pos-field">
              <label>Customer Name *</label>
              <input name="customerName" disabled data-customer-name data-title-case placeholder="Customer full name">
            </div>
            <div class="pos-field">
              <label>PAN No. (optional)</label>
              <input name="customerPan" disabled data-customer-pan placeholder="e.g. ABCDE1234F" maxlength="10" autocomplete="off" style="text-transform:uppercase;">
            </div>
            <div class="pos-field">
              <label>Email (optional)</label>
              <input name="customerEmail" type="email" disabled data-customer-email placeholder="customer@gmail.com">
            </div>
            <div class="pos-field">
              <label>City / Address</label>
              <input name="customerAddress" disabled data-customer-address data-title-case placeholder="City / Area">
            </div>
          </div>
        </section>
      </div>

      <!-- 2. Scanned Jewellery Items -->
      <div class="pos-card">
        <div class="pos-card-header">
          <h2 class="pos-card-title">Scanned Jewellery Items</h2>
          <button class="button small" type="button" data-add-row style="background:#f0ebe0; color:#5a4933; border:1px solid #dcd1c2; font-weight:750; padding:4px 10px; font-size:12px;">
            + Add Barcode Row
          </button>
        </div>

        <!-- Dynamic Barcode rows injected here by JS -->
        <div class="barcode-lines" data-rows></div>

        <!-- 3. URD Buyback / Old Gold Exchange Settlement Card -->
        <section class="urd-settlement" data-sale-urd>
          <label class="urd-toggle">
            <input type="checkbox" name="includeUrdPurchase" data-urd-enabled>
            <span>
              <strong>Adjust Old Gold / Silver (URD Buyback) against this bill</strong>
              <small>Deduct scrap jewellery exchange value directly from this bill's net payable.</small>
            </span>
          </label>

          <div class="urd-settlement-fields" data-urd-fields hidden>
            <div class="urd-grid">
              <div class="pos-field">
                <label>Metal</label>
                <select name="urdMetal" data-urd-metal><option value="GOLD">Gold</option><option value="SILVER">Silver</option></select>
              </div>
              <div class="pos-field">
                <label>Purity</label>
                <select name="urdPurity" data-urd-purity><option value="22K">22K</option><option value="24K">24K</option><option value="925">Silver 925</option><option value="PURE">Pure Silver</option></select>
              </div>
              <div class="pos-field">
                <label>Gross Wt. (g)</label>
                <input name="urdGrossWeight" type="number" min="0" step="0.001" value="0" data-urd-gross-weight>
              </div>
              <div class="pos-field">
                <label>Net Wt. (g)</label>
                <input name="urdNetWeight" type="number" min="0" step="0.001" value="0" data-urd-net-weight>
              </div>
              <div class="pos-field">
                <label>Rate / g (₹)</label>
                <input name="urdRatePerGram" type="number" min="0" step="0.01" value="0" data-urd-rate data-rate-22="<%= rateInfo.rate ? Number(rateInfo.rate.gold22k) : 0 %>" data-rate-24="<%= rateInfo.rate ? Number(rateInfo.rate.gold24k) : 0 %>" data-rate-silver="<%= rateInfo.rate ? Number(rateInfo.rate.silver) : 0 %>">
              </div>
              <div class="pos-field">
                <label>URD Total (₹)</label>
                <input name="urdTotalAmount" type="number" min="0" step="0.01" value="0" data-urd-amount>
              </div>
              <div class="pos-field" style="grid-column: span 2;">
                <label>Description</label>
                <input name="urdDescription" placeholder="Old melted gold chain, broken ring, etc.">
              </div>
            </div>
          </div>
        </section>

        <!-- Hidden Line Item Template (Cloned by JS) -->
        <template data-line-template>
          <div class="barcode-line" data-line-item>
            <!-- Line Header Row: Line Number + Barcode Input + Scanned Item Info Banner + Delete Button -->
            <div class="line-header-row">
              <div class="line-number">1</div>

              <div class="barcode-field-wrap">
                <label>Scan / Type Barcode</label>
                <input name="barcode" autocomplete="off" placeholder="e.g. G 00001" data-barcode required>
              </div>

              <input type="hidden" name="productId" data-product-id>

              <div class="scanned-item" data-item-details>
                <strong>Waiting for barcode…</strong>
                <small>Item details & live rate will appear automatically</small>
              </div>

              <button class="remove-row" type="button" title="Remove item" data-remove-row>×</button>
            </div>

            <!-- Tier 1: Main Pricing Fields -->
            <div class="line-fields-grid">
              <div class="input-unit">
                <label>Net Wt (g) *</label>
                <input name="weight" type="number" min="0.001" step="0.001" required data-weight placeholder="0.000">
              </div>
              <div class="input-unit">
                <label>Rate / g (₹) *</label>
                <input name="metalRate" type="number" min="0" step="0.01" required data-metal-rate placeholder="0.00">
              </div>
              <div class="input-unit">
                <label>Making Type</label>
                <select name="makingChargeType" data-making-type>
                  <option value="PER_GRAM" selected>Per gram</option>
                  <option value="FIXED">Fixed</option>
                  <option value="PERCENTAGE">%</option>
                </select>
              </div>
              <div class="input-unit">
                <label>Making (₹)</label>
                <input name="makingChargeValue" type="number" min="0" step="0.01" required data-making-value placeholder="0.00">
              </div>
              <div class="input-unit">
                <label>Amount ex. GST (₹)</label>
                <input name="taxableAmount" type="number" min="0" step="0.01" required data-taxable-amount placeholder="0.00">
              </div>
            </div>

            <!-- Tier 2: Secondary Specs -->
            <div class="line-specs-grid">
              <div class="input-unit">
                <label>Pieces</label>
                <input name="quantity" type="number" min="1" value="1" readonly aria-label="One barcode equals one piece" data-quantity>
              </div>
              <div class="input-unit">
                <label>Purity</label>
                <input name="purity" maxlength="30" data-purity placeholder="22K">
              </div>
              <div class="input-unit">
                <label>HSN</label>
                <input name="hsnCode" placeholder="7113" data-hsn-code autocomplete="off">
              </div>
              <div class="input-unit">
                <label>HUID</label>
                <input name="huidCode" placeholder="ABC123" data-huid-code autocomplete="off" style="text-transform: uppercase;">
              </div>
            </div>

            <small class="line-help" data-line-help></small>
          </div>
        </template>

        <div class="pos-field" style="margin-top:14px;">
          <label>Invoice Notes / Reference</label>
          <textarea name="notes" rows="2" placeholder="Bargaining note, hallmark reference, etc." style="width:100%; border:1.5px solid #ded5c5; border-radius:8px; padding:8px 10px; font-family:inherit; box-sizing:border-box;"></textarea>
        </div>
      </div>
    </section>

    <!-- Right Sidebar: Payment Summary -->
    <aside class="transaction-summary">
      <h2 class="summary-heading">Payment Summary</h2>

      <div class="summary-row">
        <span>Items Subtotal</span>
        <strong data-subtotal>₹0.00</strong>
      </div>

      <div class="summary-input-wrap">
        <label>Discount / Concession (₹)</label>
        <input name="discount" type="number" min="0" step="0.01" placeholder="0.00" data-discount>
      </div>

      <div class="summary-row">
        <span>GST (3%)</span>
        <strong data-gst>₹0.00</strong>
      </div>

      <div class="summary-row">
        <span>Round Off</span>
        <strong data-round-off>₹0.00</strong>
      </div>

      <input name="gstRate" type="hidden" value="3">

      <div class="summary-total-box">
        <span>Invoice Total</span>
        <strong data-total>₹0.00</strong>
      </div>

      <div class="summary-row" data-urd-offset-row hidden style="color:#b47a21;">
        <span>URD Buyback</span>
        <strong>− <span data-urd-offset>₹0.00</span></strong>
      </div>
      <p class="muted" data-urd-refund-note hidden>Any URD value above the bill is refunded using the method selected below.</p>

      <div class="net-payable-box">
        <span data-net-payable-label>Net Payable</span>
        <strong data-net-payable>₹0.00</strong>
      </div>

      <div class="summary-input-wrap" data-urd-refund-method hidden>
        <label>Refund Method</label>
        <select name="urdRefundMethod" data-urd-refund-method disabled>
          <option value="CASH">Cash</option>
          <option value="UPI">UPI / QR</option>
          <option value="CARD">Card</option>
          <option value="BANK_TRANSFER">Bank Transfer</option>
        </select>
      </div>

      <div class="summary-input-wrap">
        <label>Amount Received Now (₹)</label>
        <input name="paid" type="number" min="0" step="0.01" placeholder="0.00" data-paid style="font-size:14.5px; border-color:#c9a044;">
      </div>

      <div class="due-pill" data-balance-row>
        <span>Credit Due Balance</span>
        <strong data-balance>₹0.00</strong>
      </div>

      <div class="summary-input-wrap">
        <label>Payment Method</label>
        <select name="paymentMethod" data-payment-method>
          <% ['CASH','UPI','CARD','BANK_TRANSFER','MIXED'].forEach((method) => { %>
          <option value="<%= method %>"><%= method === 'CASH' ? 'Cash' : (method === 'UPI' ? 'UPI / QR' : (method === 'CARD' ? 'Card' : (method === 'BANK_TRANSFER' ? 'Bank Transfer' : 'Mixed Split Payment'))) %></option>
          <% }) %>
        </select>
      </div>

      <div class="form-grid two compact-fields" data-split-payment hidden style="display:none; background:#faf7f2; padding:10px; border-radius:8px; margin-bottom:10px; gap:8px;">
        <div class="pos-field">
          <label>Cash (₹)</label>
          <input name="cashPaid" type="number" min="0" step="0.01" value="" placeholder="0.00" data-cash-paid disabled>
        </div>
        <div class="pos-field">
          <label>UPI (₹)</label>
          <input name="upiPaid" type="number" min="0" step="0.01" value="" placeholder="0.00" data-upi-paid disabled>
        </div>
        <div class="pos-field">
          <label>Card (₹)</label>
          <input name="cardPaid" type="number" min="0" step="0.01" value="" placeholder="0.00" data-card-paid disabled>
        </div>
        <div class="pos-field">
          <label>Bank (₹)</label>
          <input name="bankPaid" type="number" min="0" step="0.01" value="" placeholder="0.00" data-bank-paid disabled>
        </div>
      </div>

      <button class="btn-submit-bill" type="submit">
        Generate & Print Bill →
      </button>
    </aside>

  </form>
</div>

<!-- Customer Outstanding Balance Alert Pop-up -->
<div class="modal-overlay" id="customerBalanceAlertModal" style="display:none; z-index:9999;" aria-hidden="true">
  <div class="modal-card" style="max-width: 440px; text-align: center; padding: 24px 20px;">
    <h2 style="font-size: 18px; margin: 0 0 8px; color: #a06010;">Outstanding Balance Notice</h2>
    <p style="font-size: 13px; color: #3d352e; line-height: 1.5; margin-bottom: 12px;">
      Customer <strong id="balanceAlertCustName">Customer</strong> (<span id="balanceAlertCustPhone">9876543210</span>) has an outstanding credit balance of:
    </p>
    <div style="background: #fff8e8; border: 1.5px solid #dfa437; border-radius: 8px; padding: 10px 14px; margin-bottom: 14px;">
      <span style="font-size: 11px; font-weight: 700; color: #84530c; text-transform: uppercase; letter-spacing: 0.05em; display: block;">Credit Due on Ledger</span>
      <strong id="balanceAlertCustAmount" style="font-size: 24px; color: #b47a21; display: block; margin-top: 2px;">₹0.00</strong>
    </div>
    <p style="font-size: 11.5px; color: #776f67; margin-bottom: 18px;">
      This is an informational notice and will not interfere with your billing.
    </p>
    <div style="display: flex; gap: 10px; justify-content: center;">
      <button type="button" class="button" id="balanceAlertOkBtn" style="min-width: 130px; background:#b47a21; color:#fff; font-weight:700;">
        OK, Continue ↵
      </button>
      <a href="#" target="_blank" rel="noopener" class="button secondary" id="balanceAlertLedgerBtn">
        View Ledger →
      </a>
    </div>
  </div>
</div>
