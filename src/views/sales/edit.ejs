<header class="page-header"><div><p class="eyebrow">Invoice correction</p><h1>Edit <%= sale.invoiceNumber %></h1></div><a class="button ghost" href="/sales/<%= sale.id %>">Cancel</a></header>
<section class="panel form-panel"><form method="post" action="/sales/<%= sale.id %>/edit" onsubmit="return confirm('Save these invoice and customer changes?')"><div class="form-section"><h2>Customer details</h2><div class="form-grid two"><label>Name *<input name="customerName" data-title-case required value="<%= sale.customer?.name || '' %>"></label><label>Mobile number *<input name="customerPhone" inputmode="numeric" minlength="10" maxlength="15" required value="<%= sale.customer?.phone || '' %>"></label><label>Email<input name="customerEmail" type="email" value="<%= sale.customer?.email || '' %>"></label><label>PAN<input name="customerPan" maxlength="20" value="<%= sale.customerPan || sale.customer?.panNumber || '' %>"></label><label class="full">Address<textarea name="customerAddress" data-title-case rows="3"><%= sale.customer?.address || '' %></textarea></label></div></div><div class="form-section"><h2>Invoice note</h2><label><textarea name="notes" rows="2" placeholder="Optional"><%= sale.notes || '' %></textarea></label></div><footer class="form-footer"><a class="button ghost" href="/sales/<%= sale.id %>">Cancel</a><button class="button" type="submit">Save changes</button></footer></form></section>
