<header class="page-header">
  <div><p class="eyebrow">Kusum Jewelers</p><h1>Good day — here’s your shop at a glance.</h1><p class="muted">Live inventory, sales and repair work in one place.</p></div>
  <div class="header-actions"><a class="button secondary" href="/repairs/new">+ Receive repair</a><a class="button" href="/sales/new">+ New sale</a></div>
</header>

<section class="stats-grid">
  <article class="stat-card accent-gold"><span class="stat-label">Available inventory</span><strong><%= stats.stockPieces %> <small>pieces</small></strong><p><%= grams(stats.stockWeight) %> net weight · <a href="/inventory">View stock</a></p></article>
  <article class="stat-card"><span class="stat-label">Today's sales</span><strong><%= money(stats.sales) %></strong><p><%= stats.invoices %> invoice<%= stats.invoices === 1 ? '' : 's' %> today</p></article>
  <article class="stat-card"><span class="stat-label">Active repairs</span><strong><%= stats.activeRepairs %></strong><p><a href="/repairs">Open repair desk</a></p></article>
  <article class="stat-card"><span class="stat-label">Catalog items</span><strong><%= stats.productCount %></strong><p>Across active inventory</p></article>
</section>

<section class="content-grid two-thirds">
  <article class="panel">
    <div class="panel-heading"><div><h2>Recent sales</h2><p>Latest invoices from your counter.</p></div><a class="text-link" href="/sales">All sales →</a></div>
    <% if (recentSales.length) { %>
    <div class="table-wrap"><table><thead><tr><th>Invoice</th><th>Customer</th><th>Date</th><th class="right">Total</th></tr></thead><tbody>
      <% recentSales.forEach((sale) => { %><tr><td><a href="/sales/<%= sale.id %>"><strong><%= sale.invoiceNumber %></strong></a></td><td><%= sale.customer?.name || 'Walk-in customer' %></td><td><%= sale.saleDate.toLocaleDateString('en-IN', { day: '2-digit', month: 'short' }) %></td><td class="right"><strong><%= money(sale.total) %></strong></td></tr><% }) %>
    </tbody></table></div>
    <% } else { %><div class="empty-state"><span>₹</span><h3>No sales recorded yet</h3><p>Create your first invoice from the sales desk.</p><a class="button" href="/sales/new">Create sale</a></div><% } %>
  </article>
  <article class="panel">
    <div class="panel-heading"><div><h2>Needs attention</h2><p>Low inventory items.</p></div><a class="text-link" href="/inventory">Inventory →</a></div>
    <% if (lowStock.length) { %><ul class="attention-list"><% lowStock.forEach((product) => { %><li><div class="item-icon"><%= product.metal === 'GOLD' ? '◇' : '○' %></div><div><strong><%= product.name %></strong><small><%= product.sku %> · <%= product.purity || product.metal %></small></div><span class="pill warning"><%= product.quantity %> left</span></li><% }) %></ul>
    <% } else { %><div class="empty-state compact"><span>✓</span><h3>Stock levels look good</h3><p>Nothing is currently at its reorder level.</p></div><% } %>
  </article>
</section>
