<header class="page-header">
  <div>
    <p class="eyebrow">Master data</p>
    <h1>Item Names</h1>
    <p class="muted">Maintain a master list of item names and categories. These appear as suggestions when adding inventory.</p>
  </div>
  <div class="header-actions">
    <a class="button ghost" href="/inventory">Back to inventory</a>
  </div>
</header>

<section class="panel">
  <div class="panel-heading"><div><h2>Add new item name</h2><p>This name will appear in autocomplete when adding inventory.</p></div></div>
  <div class="item-names-add">
    <form method="post" action="/item-names/add" id="addItemNameForm" style="display:flex; align-items:flex-end; gap:10px; flex-wrap:wrap; width:100%;">
      <label>
        <span>Item name *</span>
        <input name="name" required placeholder="e.g. Gold bridal necklace">
      </label>
      <label>
        <span>Category *</span>
        <input name="category" required placeholder="e.g. Necklace, Ring, Chain">
      </label>
      <button class="button small" type="submit">+ Add</button>
    </form>
  </div>
</section>

<% const allItems = typeof items !== 'undefined' && Array.isArray(items) ? items : []; %>
<section class="panel">
  <div class="panel-heading"><div><h2>All item names</h2><p><%= allItems.length %> registered name<%= allItems.length !== 1 ? 's' : '' %>.</p></div></div>
  <% if (allItems.length) { %>
    <% allItems.forEach((item) => { %>
    <form class="item-name-row" method="post" action="/item-names/<%= item.id %>">
      <input name="name" value="<%= item.name %>" required placeholder="Item name">
      <input name="category" value="<%= item.category %>" required placeholder="Category">
      <button class="button small ghost" type="submit">Save</button>
      <button class="button small ghost" type="submit" formaction="/item-names/<%= item.id %>/delete" onclick="return confirm('Delete this item name?')">✕</button>
    </form>
    <% }) %>
  <% } else { %>
    <div class="empty-state compact"><span>⊞</span><h3>No item names yet</h3><p>Add your first item name above, or they'll be auto-registered when you save inventory items.</p></div>
  <% } %>
</section>
