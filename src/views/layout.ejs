<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= title %> · Kusum ERP</title>
    <link rel="stylesheet" href="/styles.css">
  </head>
  <body>
    <div class="app-shell">
      <!-- Mobile Responsive Top Bar -->
      <div class="mobile-top-bar">
        <button type="button" class="mobile-menu-toggle" id="mobileMenuToggle" aria-label="Toggle navigation menu">
          <span>☰</span>
        </button>
        <a class="mobile-brand" href="/">
          <span class="brand-mark-sm">K</span>
          <strong>Kusum ERP</strong>
        </a>
      </div>
      <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

      <aside class="sidebar" id="appSidebar">
        <a class="brand" href="/">
          <span class="brand-mark">K</span>
          <span>Kusum ERP<small>Jewelry management</small></span>
        </a>
        <nav>
          <a class="<%= currentPath === '/' ? 'active' : '' %>" href="/"><span>▦</span> Dashboard</a>
          <a class="<%= currentPath.startsWith('/inventory') ? 'active' : '' %>" href="/inventory"><span>◇</span> Inventory</a>
          <a class="nav-sub <%= currentPath.startsWith('/item-names') ? 'active' : '' %>" href="/item-names"><span>⊞</span> Item Names</a>
          <a class="<%= currentPath.startsWith('/rates') ? 'active' : '' %>" href="/rates"><span>⌁</span> Daily rates</a>
          <a class="<%= currentPath.startsWith('/sales') ? 'active' : '' %>" href="/sales"><span>₹</span> Sales</a>
          <a class="<%= currentPath.startsWith('/urd') ? 'active' : '' %>" href="/urd-purchases"><span>⇣</span> URD Purchase</a>
          <a class="<%= currentPath.startsWith('/cashbook') ? 'active' : '' %>" href="/cashbook"><span>⊟</span> Cashbook</a>
          <a class="<%= currentPath.startsWith('/customers') ? 'active' : '' %>" href="/customers"><span>◎</span> Customers</a>
          <a class="<%= currentPath.startsWith('/schemes') ? 'active' : '' %>" href="/schemes"><span>⬡</span> Schemes</a>
          <a class="<%= currentPath.startsWith('/data-management') ? 'active' : '' %>" href="/data-management"><span>⇩</span> Export & archive</a>
          <a class="<%= currentPath.startsWith('/reports') ? 'active' : '' %>" href="/reports"><span>▤</span> Reports</a>
          <a class="<%= currentPath.startsWith('/network-setup') ? 'active' : '' %>" href="/network-setup"><span>⌁</span> Network PCs</a>
        </nav>
        <div class="sidebar-foot">
          Signed in as <strong><%= loggedInUser %></strong>
          <button class="sidebar-language" type="button" data-ui-language-toggle aria-label="Switch ERP interface language">मराठी</button>
          <a class="sidebar-logout" href="/change-password">Change password</a>
          <form method="post" action="/logout"><button class="sidebar-logout" type="submit">Sign out</button></form>
        </div>
      </aside>
      <main class="main-content">
        <div class="workspace-toolbar" aria-label="Workspace tools">
          <button class="global-search-trigger" type="button" data-global-search-open aria-haspopup="dialog">
            <span class="global-search-icon" aria-hidden="true">⌕</span>
            <span>Search barcode, invoice, customer…</span>
            <kbd>Ctrl K</kbd>
          </button>
        </div>
        <% if (message) { %><div class="flash success"><span>✓</span><%= message %></div><% } %>
        <% if (error) { %><div class="flash error"><span>!</span><%= error %></div><% } %>
        <%- body %>
      </main>
    </div>
    <div class="modal-overlay global-search-modal" id="globalSearchModal" style="display:none;" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="globalSearchTitle">
      <section class="modal-card global-search-card" role="document">
        <header class="global-search-header">
          <label id="globalSearchTitle" class="sr-only" for="globalSearchInput">Search ERP records</label>
          <span aria-hidden="true">⌕</span>
          <input id="globalSearchInput" type="search" autocomplete="off" spellcheck="false" placeholder="Search barcode, invoice, customer, URD or scheme">
          <button class="modal-close-btn" type="button" data-global-search-close aria-label="Close search">×</button>
        </header>
        <div class="global-search-help" data-global-search-help>Type at least 2 characters to search available stock and recent records.</div>
        <div class="global-search-results" data-global-search-results aria-live="polite"></div>
      </section>
    </div>
    <script src="/i18n.js"></script>
    <script src="/app.js"></script>
  </body>
</html>
