<% const activePurchases = Array.isArray(supplier.purchases) ? supplier.purchases : []; const paymentRows = Array.isArray(supplier.paymentRows) ? supplier.paymentRows.map((entry) => ({ ...entry, purchase: entry.supplierPurchase })).filter((row) => row.purchase) : activePurchases.flatMap((purchase) => (purchase.cashbookEntries || []).map((entry) => ({ ...entry, purchase }))); %>
<header class="page-header supplier-account-header"><div><p class="eyebrow">Supplier account</p><h1><%= supplier.name %></h1><p class="muted"><%= supplier.phone || 'No mobile saved' %><%= supplier.gstin ? ` · GSTIN ${supplier.gstin}` : '' %></p></div><div class="header-actions"><a class="button ghost" href="/suppliers">All suppliers</a><a class="button ghost" href="/purchases?q=<%= encodeURIComponent(supplier.name) %>">Purchase register</a><button class="button ghost" type="button" data-supplier-edit-open>Edit supplier</button><a class="button" href="/purchases/new">+ New purchase</a></div></header>
<section class="supplier-account-summary"><article class="supplier-account-due"><span>Outstanding due</span><strong><%= money(summary.due) %></strong><small>Amount payable to this supplier</small></article><article><span>Purchase value</span><strong><%= money(summary.purchased) %></strong><small><%= summary.purchaseCount %> active purchase<%= summary.purchaseCount === 1 ? '' : 's' %></small></article><article><span>Paid</span><strong><%= money(summary.paid) %></strong><small><%= Number(summary.weight).toFixed(3) %> g · <%= summary.pieces %> pieces</small></article></section>
<section class="panel supplier-account-panel">
  <nav class="supplier-account-tabs" aria-label="Supplier account views"><button class="supplier-tab is-active" type="button" data-supplier-tab="overview">Overview</button><button class="supplier-tab" type="button" data-supplier-tab="purchases">Purchases</button><button class="supplier-tab" type="button" data-supplier-tab="payments">Payments</button><a class="supplier-tab" href="/purchases?state=CANCELLED&q=<%= encodeURIComponent(supplier.name) %>">Cancelled</a></nav>
  <div class="supplier-tab-panel is-active" data-supplier-panel="overview"><div class="panel-heading"><div><h2>Recent activity</h2><p>Purchases and payments for this supplier.</p></div></div><% if (activePurchases.length || paymentRows.length) { %><div class="supplier-activity-list"><% const activity = [...activePurchases.map((purchase) => ({ date: purchase.purchaseDate, kind: 'Purchase', title: purchase.purchaseNumber, detail: `${purchase.itemName} · ${purchase.metal}`, amount: purchase.totalAmount, href: `/purchases/${purchase.id}/edit` })), ...paymentRows.map((row) => ({ date: row.entryDate, kind: 'Payment', title: row.purchase.purchaseNumber, detail: `${row.paymentMethod.replace('_', ' ')} payment`, amount: row.amount, href: `/purchases?q=${encodeURIComponent(row.purchase.purchaseNumber)}` }))].sort((a, b) => new Date(b.date) - new Date(a.date)); activity.slice(0, 12).forEach((entry) => { %><a class="supplier-activity-row" href="<%= entry.href %>"><span class="supplier-activity-icon <%= entry.kind === 'Payment' ? 'is-payment' : '' %>"><%= entry.kind === 'Payment' ? '↓' : '＋' %></span><span><strong><%= entry.kind %> · <%= entry.title %></strong><small><%= formatDateDisplay(entry.date) %> · <%= entry.detail %></small></span><strong class="supplier-activity-amount"><%= money(entry.amount) %></strong></a><% }); %></div><% } else { %><div class="empty-state compact"><h3>No activity yet</h3><p>Record a purchase to start this supplier account.</p></div><% } %></div>
  <div class="supplier-tab-panel" data-supplier-panel="purchases"><div class="panel-heading"><div><h2>Purchases</h2><p>Every active lot remains under this supplier. Showing <%= purchasePagination.fromItem %>–<%= purchasePagination.toItem %> of <%= purchasePagination.totalItems %>.</p></div><a class="button ghost small" href="/purchases/new">+ New purchase</a></div><% if (activePurchases.length) { %><div class="table-wrap"><table><thead><tr><th>Purchase</th><th>Lot received</th><th class="right">Pieces / weight</th><th class="right">Total</th><th class="right">Paid</th><th class="right">Due</th><th>Actions</th></tr></thead><tbody><% activePurchases.forEach((purchase) => { const due = Math.max(0, Number(purchase.totalAmount) - Number(purchase.paid)); %><tr><td><strong><%= purchase.purchaseNumber %></strong><small><%= formatDateDisplay(purchase.purchaseDate) %></small></td><td><strong><%= purchase.itemName %></strong><small><%= purchase.category %> · <%= purchase.metal %><%= purchase.purity ? ` · ${purchase.purity}` : '' %></small></td><td class="right"><strong><%= Number(purchase.quantity || 1) %></strong><small><%= Number(purchase.netWeight).toFixed(3) %> g</small></td><td class="right"><strong><%= money(purchase.totalAmount) %></strong></td><td class="right"><strong class="paid-amount"><%= money(purchase.paid) %></strong></td><td class="right"><strong class="<%= due > 0 ? 'credit-amount' : 'paid-amount' %>"><%= money(due) %></strong></td><td class="supplier-table-actions"><a class="button ghost small" href="/purchases/<%= purchase.id %>/edit">Edit</a><a class="button secondary small" href="/purchases?q=<%= encodeURIComponent(purchase.purchaseNumber) %>">Payments</a></td></tr><% }) %></tbody></table></div><%- include('../_pagination', { pagination: purchasePagination }) %><% } else { %><div class="empty-state compact"><h3>No active purchases</h3><p>This supplier currently has no active purchase record.</p></div><% } %></div>
  <div class="supplier-tab-panel" data-supplier-panel="payments"><div class="panel-heading"><div><h2>Payments</h2><p>Supplier payouts recorded in Cashbook. Showing <%= paymentPagination.fromItem %>–<%= paymentPagination.toItem %> of <%= paymentPagination.totalItems %>.</p></div></div><% if (paymentRows.length) { %><div class="table-wrap"><table><thead><tr><th>Date</th><th>Purchase</th><th>Method</th><th>Reference</th><th class="right">Amount</th><th></th></tr></thead><tbody><% paymentRows.forEach((entry) => { %><tr><td><%= formatDateDisplay(entry.entryDate) %></td><td><strong><%= entry.purchase.purchaseNumber %></strong><small><%= entry.purchase.itemName %></small></td><td><%= entry.paymentMethod.replace('_', ' ') %></td><td><%= entry.reference || '—' %></td><td class="right"><strong class="paid-amount"><%= money(entry.amount) %></strong></td><td><a class="button ghost small" href="/purchases?q=<%= encodeURIComponent(entry.purchase.purchaseNumber) %>">Manage</a></td></tr><% }) %></tbody></table></div><%- include('../_pagination', { pagination: paymentPagination, pageParam: 'paymentPage' }) %><% } else { %><div class="empty-state compact"><h3>No payments recorded</h3><p>Payments will appear here after they are recorded.</p></div><% } %></div>
</section>
<div class="modal-overlay" id="supplierEditModal" style="display:none" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="supplierEditTitle"><section class="modal-card"><header class="modal-header"><div><p class="eyebrow">Supplier profile</p><h2 id="supplierEditTitle">Edit supplier</h2></div><button class="modal-close-btn" type="button" data-supplier-edit-close aria-label="Close">×</button></header><form method="post" action="/suppliers/<%= supplier.id %>"><div class="modal-body"><div class="form-grid customer-edit-fields"><label>Supplier name *<input name="name" data-uppercase required value="<%= supplier.name %>"></label><label>Mobile number<input name="phone" inputmode="numeric" maxlength="15" value="<%= supplier.phone || '' %>"></label><label>Email<input name="email" type="email" value="<%= supplier.email || '' %>"></label><label>GSTIN<input name="gstin" data-uppercase maxlength="20" value="<%= supplier.gstin || '' %>"></label><label>PAN<input name="panNumber" data-uppercase maxlength="20" value="<%= supplier.panNumber || '' %>"></label><label class="full">Address<textarea name="address" data-uppercase rows="3"><%= supplier.address || '' %></textarea></label></div></div><footer class="modal-footer"><button class="button ghost" type="button" data-supplier-edit-close>Cancel</button><button class="button" type="submit">Save supplier</button></footer></form></section></div>
<style>.supplier-account-header .muted{margin-top:5px}.supplier-account-summary{display:grid;grid-template-columns:1.25fr 1fr 1fr;gap:12px;margin-bottom:16px}.supplier-account-summary article{padding:16px;border:1px solid var(--border,#e6dfd3);border-radius:12px;background:var(--surface,#fff)}.supplier-account-summary span{display:block;color:var(--muted,#70685e);font-size:11px;font-weight:800;letter-spacing:.06em;text-transform:uppercase}.supplier-account-summary strong{display:block;margin-top:5px;font-size:21px}.supplier-account-summary small{display:block;margin-top:4px;color:var(--muted,#70685e)}.supplier-account-summary .supplier-account-due{background:rgba(193,142,33,.08);border-color:rgba(193,142,33,.32)}.supplier-account-tabs{display:flex;gap:4px;padding:4px;border-bottom:1px solid var(--border,#e6dfd3)}.supplier-tab{border:0;background:transparent;border-radius:8px;padding:9px 14px;color:var(--muted,#70685e);font:inherit;font-weight:700;cursor:pointer}.supplier-tab:hover,.supplier-tab.is-active{color:var(--text,#1f1a14);background:rgba(193,142,33,.12)}.supplier-tab-panel{display:none;padding-top:2px}.supplier-tab-panel.is-active{display:block}.supplier-activity-list{display:grid}.supplier-activity-row{display:grid;grid-template-columns:30px 1fr auto;align-items:center;gap:11px;padding:12px 4px;border-bottom:1px solid var(--border,#eee);color:inherit;text-decoration:none}.supplier-activity-row:last-child{border-bottom:0}.supplier-activity-row:hover{background:rgba(193,142,33,.04)}.supplier-activity-icon{display:grid;place-items:center;width:28px;height:28px;border-radius:50%;background:rgba(193,142,33,.14);color:#9a6811;font-weight:800}.supplier-activity-icon.is-payment{background:rgba(45,126,84,.12);color:#2c7d54}.supplier-activity-row small{display:block;color:var(--muted,#70685e);margin-top:3px}.supplier-activity-amount{font-size:14px}.supplier-table-actions{display:flex;gap:6px}.supplier-tab-panel .table-wrap{margin-top:4px}@media(max-width:760px){.supplier-account-summary{grid-template-columns:1fr}.supplier-account-tabs{overflow:auto}.supplier-activity-row{grid-template-columns:30px 1fr}.supplier-activity-amount{grid-column:2}.supplier-table-actions{flex-wrap:wrap}}</style>
<script>(()=>{const tabs=document.querySelectorAll('[data-supplier-tab]'),panels=document.querySelectorAll('[data-supplier-panel]');tabs.forEach(tab=>tab.addEventListener('click',()=>{const target=tab.dataset.supplierTab;tabs.forEach(item=>item.classList.toggle('is-active',item===tab));panels.forEach(panel=>panel.classList.toggle('is-active',panel.dataset.supplierPanel===target));history.replaceState(null,'',`#${target}`)}));const initial=location.hash.slice(1);Array.from(tabs).find(tab=>tab.dataset.supplierTab===initial)?.click();const modal=document.getElementById('supplierEditModal'),open=document.querySelector('[data-supplier-edit-open]');if(!modal||!open)return;const close=()=>{modal.style.display='none';modal.setAttribute('aria-hidden','true');open.focus()};open.addEventListener('click',()=>{modal.style.display='flex';modal.setAttribute('aria-hidden','false');setTimeout(()=>modal.querySelector('[name=name]')?.focus(),0)});modal.querySelectorAll('[data-supplier-edit-close]').forEach(button=>button.addEventListener('click',close));modal.addEventListener('click',event=>{if(event.target===modal)close()});document.addEventListener('keydown',event=>{if(event.key==='Escape'&&modal.style.display==='flex')close()})})();</script>
