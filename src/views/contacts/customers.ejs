<header class="page-header"><div><p class="eyebrow">Contacts</p><h1>Customers</h1><p class="muted">Mobile number is the customer ID for billing, credit and ledger lookup.</p></div><a class="button ghost" href="/data-management?resource=customers">Export / archive</a></header>
<section class="content-grid contact-layout"><article class="panel"><div class="panel-heading"><div><h2>Customer book</h2><p><%= customers.length %> customer<%= customers.length === 1 ? '' : 's' %><%= q ? ' found' : ' saved' %></p></div></div><form class="search-bar customer-search" method="get"><input name="q" value="<%= q || '' %>" placeholder="Search by name, mobile number or email" autofocus><button class="button secondary" type="submit">Search</button><% if (q) { %><a class="button ghost" href="/customers">Clear</a><% } %></form><% if (customers.length) { %><div class="table-wrap"><table><thead><tr><th>Name</th><th>Customer mobile / ID</th><th>Sales</th><th class="right">Credit due</th><th></th></tr></thead><tbody><% customers.forEach((customer) => { %><tr><td><strong><%= customer.name %></strong><small><%= customer.email || '' %></small></td><td><strong><%= customer.phone || '—' %></strong></td><td><span class="pill neutral"><%= customer._count.sales %> sale<%= customer._count.sales === 1 ? '' : 's' %></span></td><td class="right"><strong class="<%= customer.outstanding > 0 ? 'credit-amount' : '' %>"><%= money(customer.outstanding) %></strong></td><td><a class="button secondary small" href="/customers/<%= customer.id %>"><%= customer.outstanding > 0 ? 'Receive payment' : 'View sheet' %></a></td></tr><% }) %></tbody></table></div><% } else { %><div class="empty-state compact"><span>◎</span><h3><%= q ? 'No matching customer' : 'No customers saved' %></h3><p><%= q ? 'Try a different name, mobile number or email.' : 'A customer is created automatically when a new mobile number is used in billing.' %></p></div><% } %></article>
<aside class="panel side-form"><h2>Add customer</h2><form method="post" action="/customers"><label>Full name *<input name="name" required></label><label>Mobile number / customer ID *<input name="phone" inputmode="numeric" minlength="10" maxlength="15" required></label><label>Email<input name="email" type="email"></label><label>Address<textarea name="address" rows="3"></textarea></label><button class="button full" type="submit">Save customer</button></form></aside></section>
