<header class="page-header"><div><p class="eyebrow">Contacts</p><h1>Suppliers</h1><p class="muted">Maintain vendor details and purchase history.</p></div><a class="button ghost" href="/data-management?resource=suppliers">Export / archive</a></header>
<section class="content-grid contact-layout"><article class="panel"><div class="panel-heading"><div><h2>Supplier directory</h2><p><%= suppliers.length %> supplier<%= suppliers.length === 1 ? '' : 's' %> saved</p></div></div><% if (suppliers.length) { %><div class="table-wrap"><table><thead><tr><th>Supplier</th><th>Phone</th><th>GSTIN</th><th>Purchases</th></tr></thead><tbody><% suppliers.forEach((supplier) => { %><tr><td><strong><%= supplier.name %></strong><small><%= supplier.email || '' %></small></td><td><%= supplier.phone || '—' %></td><td><%= supplier.gstin || '—' %></td><td><span class="pill neutral"><%= supplier._count.purchases %> bill<%= supplier._count.purchases === 1 ? '' : 's' %></span></td></tr><% }) %></tbody></table></div><% } else { %><div class="empty-state compact"><span>◌</span><h3>No suppliers saved</h3><p>Add suppliers before recording purchases.</p></div><% } %></article>
<aside class="panel side-form"><h2>Add supplier</h2><form method="post" action="/suppliers"><label>Supplier name *<input name="name" required></label><label>Phone<input name="phone" inputmode="tel"></label><label>Email<input name="email" type="email"></label><label>GSTIN<input name="gstin"></label><label>Address<textarea name="address" rows="3"></textarea></label><button class="button full" type="submit">Save supplier</button></form></aside></section>
