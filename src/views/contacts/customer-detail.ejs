<% const unpaidCount = typeof unpaidSalesCount !== 'undefined' ? unpaidSalesCount : customer.sales.filter((sale) => Number(sale.balance) > 0).length; %>
<header class="page-header">
  <div><p class="eyebrow">Customer credit sheet</p><h1><%= customer.name %></h1><p class="muted"><%= customer.phone || 'No phone saved' %><%= customer.address ? ` · ${customer.address}` : '' %></p></div>
  <div class="header-actions"><a class="button ghost" href="/customers">All customers</a><a class="button ghost" href="/data-management?resource=customer-ledger">Export ledger</a><button class="button ghost" type="button" data-customer-edit-open>Edit customer</button><a class="button secondary" href="/sales/new">New sale</a></div>
</header>
<section class="customer-summary">
  <article class="stat-card accent-gold"><span class="stat-label">Current credit due</span><strong><%= money(outstanding) %></strong><p>Across <%= unpaidCount %> unpaid invoice<%= unpaidCount === 1 ? '' : 's' %></p></article>
  <article class="stat-card"><span class="stat-label">Recent invoices</span><strong><%= customer.sales.length %></strong><p>Sales recorded for this customer</p></article>
</section>
<section class="content-grid customer-detail-grid">
  <article class="panel">
    <div class="panel-heading"><div><h2>Credit &amp; payment log</h2><p>Each credit sale and received payment is recorded here.</p></div></div>
    <% if (customer.ledger.length) { %>
      <div class="table-wrap"><table><thead><tr><th>Date</th><th>Entry</th><th>Method</th><th class="right">Amount</th><th class="right">Running due</th></tr></thead><tbody>
        <% customer.ledger.slice().reverse().forEach((entry) => { %>
          <tr><td><%= formatDateDisplay(entry.createdAt) %></td><td><span class="pill <%= Number(entry.amount) < 0 ? 'success' : 'warning' %>"><%= entry.type === 'SALE_CREDIT' ? 'Credit sale' : entry.type === 'PAYMENT_RECEIVED' ? 'Payment received' : 'Adjustment' %></span><small><%= entry.note || '' %></small></td><td><%= entry.paymentMethod?.replace('_', ' ') || '—' %></td><td class="right"><strong class="<%= Number(entry.amount) < 0 ? 'paid-amount' : 'credit-amount' %>"><%= Number(entry.amount) < 0 ? '− ' : '' %><%= money(Math.abs(Number(entry.amount))) %></strong></td><td class="right"><%= money(entry.runningDue !== undefined ? entry.runningDue : outstanding) %></td></tr>
        <% }) %>
      </tbody></table></div>
      <%- include('../_pagination', { pagination: typeof pagination !== 'undefined' ? pagination : null }) %>
    <% } else { %>
      <div class="empty-state compact"><span>✓</span><h3>No credit entries</h3><p>This customer currently has no payment due.</p></div>
    <% } %>
  </article>
  <aside class="panel side-form receive-payment">
    <h2>Receive payment</h2>
    <form method="post" action="/customers/<%= customer.id %>/payments">
      <label>Amount received (₹) *<input name="amount" type="number" min="0.01" max="<%= outstanding %>" step="0.01" required value="<%= outstanding > 0 ? outstanding : '' %>" <%= outstanding <= 0 ? 'disabled' : '' %>></label>
      <label>Payment method<select name="paymentMethod" data-payment-method <%= outstanding <= 0 ? 'disabled' : '' %>><% ['CASH','UPI','CARD','BANK_TRANSFER'].forEach((method) => { %><option value="<%= method %>"><%= method.replace('_', ' ') %></option><% }) %></select></label>
      <label>Note<textarea name="note" rows="3" placeholder="Optional payment note" <%= outstanding <= 0 ? 'disabled' : '' %>></textarea></label>
      <button class="button full" type="submit" <%= outstanding <= 0 ? 'disabled' : '' %>><%= outstanding > 0 ? 'Receive payment' : 'No credit pending' %></button>
    </form>
  </aside>
</section>
<div class="modal-overlay customer-edit-modal" id="customerEditModal" style="display:none" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="customerEditTitle">
  <section class="modal-card">
    <header class="modal-header">
      <div><p class="eyebrow">Customer profile</p><h2 id="customerEditTitle">Edit customer</h2></div>
      <button class="modal-close-btn" type="button" data-customer-edit-close aria-label="Close edit customer">✕</button>
    </header>
    <form method="post" action="/customers/<%= customer.id %>" onsubmit="return confirm('Save these customer details? All linked invoices and PDFs will show the updated customer information.')">
      <div class="modal-body">
        <div class="form-grid customer-edit-fields">
          <label>Full name *<input name="name" data-title-case required value="<%= customer.name %>"></label>
          <label>Mobile number / ID *<input name="phone" inputmode="numeric" minlength="10" maxlength="15" required value="<%= customer.phone || '' %>"></label>
          <label>Email<input name="email" type="email" value="<%= customer.email || '' %>"></label>
          <label>PAN<input name="panNumber" maxlength="20" data-uppercase value="<%= customer.panNumber || '' %>"></label>
          <label class="full">Address<textarea name="address" data-title-case rows="3"><%= customer.address || '' %></textarea></label>
        </div>
      </div>
      <footer class="modal-footer customer-edit-footer"><button class="button ghost" type="button" data-customer-edit-close>Cancel</button><button class="button" type="submit">Save changes</button></footer>
    </form>
  </section>
</div>
