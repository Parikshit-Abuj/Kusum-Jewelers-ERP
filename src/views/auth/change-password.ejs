<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Change ERP password · Kusum ERP</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body class="login-page">
  <main class="login-card">
    <span class="brand-mark">K</span>
    <p class="eyebrow">Secure ERP access</p>
    <h1>Choose your ERP password</h1>
    <p class="muted">Signed-in user: <strong><%= username %></strong>. The password is saved only as a secure salted hash.</p>
    <% if (error) { %><div class="flash error"><span>!</span><%= error %></div><% } %>
    <% if (message) { %><div class="flash success"><span>✓</span><%= message %></div><% } %>
    <form method="post" action="/change-password">
      <% if (requireCurrentPassword) { %>
        <label>Current password<input name="currentPassword" type="password" required autocomplete="current-password"></label>
      <% } %>
      <label>New password<input name="newPassword" type="password" required autocomplete="new-password" autofocus></label>
      <label>Confirm new password<input name="confirmPassword" type="password" required autocomplete="new-password"></label>
      <p class="form-hint">There is no compulsory character count. For safety, use a password that customers and staff cannot easily guess.</p>
      <button class="button full large" type="submit">Save password and continue</button>
    </form>
  </main>
</body>
</html>
