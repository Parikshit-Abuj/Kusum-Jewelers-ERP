<header class="page-header">
  <div><p class="eyebrow">Supplier gold & silver buying</p><h1>Purchase Register</h1></div>
  <div class="header-actions"><a class="button ghost" href="/suppliers">Suppliers</a><button class="button ghost" type="button" data-export-modal-open="supplierPurchaseExportModal">Export Excel</button><a class="button" href="/purchases/new">+ New purchase</a></div>
</header>
<% const list = Array.isArray(purchases) ? purchases : []; const paymentFilter = typeof paymentStatus === 'string' ? paymentStatus : 'ALL'; const supplierGroups = Array.from(list.reduce((groups, purchase) => { const supplierKey = String(purchase.supplier?.name || `Unknown supplier ${purchase.id}`).trim().toLocaleUpperCase(); if (!groups.has(supplierKey)) groups.set(supplierKey, { supplier: purchase.supplier, purchases: [] }); groups.get(supplierKey).purchases.push(purchase); return groups; }, new Map()).values()); %>
<section class="panel register-panel purchase-register-shell">
  <form class="search-bar purchase-filter-bar" method="get" action="/purchases">
    <input name="q" value="<%= q || '' %>" placeholder="Search supplier, item, metal or purchase no.">
    <select name="state"><option value="ACTIVE" <%= state === 'ACTIVE' ? 'selected' : '' %>>Active purchases</option><option value="CANCELLED" <%= state === 'CANCELLED' ? 'selected' : '' %>>Cancelled purchases</option></select>
    <select name="paymentStatus"><option value="ALL" <%= paymentFilter === 'ALL' ? 'selected' : '' %>>All payments</option><option value="PENDING" <%= paymentFilter === 'PENDING' ? 'selected' : '' %>>Pending payments</option><option value="PAID" <%= paymentFilter === 'PAID' ? 'selected' : '' %>>Fully paid</option></select>
    <button class="button secondary" type="submit">Filter</button><% if (q || paymentFilter !== 'ALL' || state !== 'ACTIVE') { %><a class="button ghost" href="/purchases">Clear</a><% } %>
  </form>
  <% if (list.length) { %>
  <div class="purchase-register-list">
    <% supplierGroups.forEach((supplierGroup) => { const supplierTotal = supplierGroup.purchases.reduce((sum, purchase) => sum + Number(purchase.totalAmount), 0); const supplierDue = supplierGroup.purchases.reduce((sum, purchase) => sum + Math.max(0, Number(purchase.totalAmount) - Number(purchase.paid)), 0); %>
    <section class="supplier-purchase-group">
      <header class="supplier-purchase-heading">
        <div><span>Supplier</span><a href="/suppliers/<%= supplierGroup.supplier.id %>"><strong><%= supplierGroup.supplier.name %></strong></a><small><%= supplierGroup.supplier.phone || 'No mobile saved' %> · <%= supplierGroup.purchases.length %> purchase<%= supplierGroup.purchases.length === 1 ? '' : 's' %></small></div>
        <div class="supplier-purchase-totals"><small>Listed value <strong><%= money(supplierTotal) %></strong></small><small class="<%= supplierDue > 0 ? 'credit-amount' : 'paid-amount' %>"><%= supplierDue > 0 ? `Due ${money(supplierDue)}` : 'No due' %></small></div>
      </header>
      <div class="supplier-purchase-items">
    <% supplierGroup.purchases.forEach((purchase) => { const due = Math.max(0, Number(purchase.totalAmount) - Number(purchase.paid)); const isActive = state === 'ACTIVE'; const paymentCount = purchase.cashbookEntries?.length || 0; %>
    <article class="purchase-register-card">
      <div class="purchase-card-heading"><div><strong><%= purchase.purchaseNumber %></strong><small><%= formatDateDisplay(purchase.purchaseDate) %><%= purchase.reference ? ` · ${purchase.reference}` : '' %></small></div><% if (!isActive) { %><span class="pill danger">Cancelled</span><% } else if (due > 0) { %><span class="pill warning">Due <%= money(due) %></span><% } else { %><span class="pill success">Paid</span><% } %></div>
      <div class="purchase-card-grid"><div class="purchase-card-block"><span>Lot received</span><strong><%= purchase.itemName %></strong><small><%= purchase.category %> · <%= purchase.metal %><%= purchase.purity ? ` · ${purchase.purity}` : '' %><br><%= Number(purchase.quantity || 1) %> piece<%= Number(purchase.quantity || 1) === 1 ? '' : 's' %> · <%= Number(purchase.netWeight).toFixed(3) %> g</small></div><div class="purchase-card-block purchase-card-money"><span>Purchase value</span><strong><%= money(purchase.totalAmount) %></strong><small>Paid <%= money(purchase.paid) %> · <%= due > 0 ? `Due ${money(due)}` : 'No due' %></small></div></div>
      <footer class="purchase-card-actions"><% if (isActive) { %><button class="button secondary small" type="button" data-purchase-manage-open="purchaseManage<%= purchase.id %>"><%= due > 0 ? 'Manage payment' : 'Payment history' %><%= paymentCount ? ` (${paymentCount})` : '' %></button><form method="post" action="/purchases/<%= purchase.id %>/delete" onsubmit="return confirm('Cancel this supplier purchase? Linked cashbook payouts will be reversed. Individually barcode-labelled inventory items are not changed.')"><button class="button ghost small danger-action" type="submit">Cancel purchase</button></form><% } else { %><span class="muted">Cancelled purchases remain as an audit record.</span><% } %></footer>
    </article>
    <% if (isActive) { %>
    <div class="modal-overlay" id="purchaseManage<%= purchase.id %>" style="display:none" aria-hidden="true" role="dialog" aria-modal="true"><section class="modal-card purchase-payment-modal"><header class="modal-header"><div><p class="eyebrow">Supplier purchase</p><h2><%= purchase.purchaseNumber %></h2><p class="muted"><%= purchase.supplier.name %> · <%= purchase.itemName %></p></div><button class="modal-close-btn" type="button" data-purchase-manage-close aria-label="Close">×</button></header><div class="modal-body purchase-payment-body"><div class="purchase-payment-summary"><span>Total <strong><%= money(purchase.totalAmount) %></strong></span><span>Paid <strong><%= money(purchase.paid) %></strong></span><span class="<%= due > 0 ? 'credit-amount' : 'paid-amount' %>">Due <strong><%= money(due) %></strong></span></div><% if (paymentCount) { %><h3>Payment history</h3><div class="purchase-history-list"><% purchase.cashbookEntries.forEach((entry) => { %><div class="purchase-history-row"><div><strong><%= money(entry.amount) %></strong><small><%= formatDateDisplay(entry.entryDate) %> · <%= entry.paymentMethod.replace('_', ' ') %><%= entry.notes ? ` · ${entry.notes}` : '' %></small></div><button class="button ghost small" type="button" data-purchase-payment-edit-open="purchasePaymentEdit<%= entry.id %>">Edit</button></div><% }) %></div><% } else { %><div class="empty-state compact"><h3>No payment recorded</h3><p>Record the supplier payment when it is actually paid.</p></div><% } %><% if (due > 0) { %><button class="button purchase-record-button" type="button" data-purchase-payment-add-open="purchasePaymentAdd<%= purchase.id %>">+ Record payment</button><% } %></div><footer class="modal-footer"><button class="button ghost" type="button" data-purchase-manage-close>Done</button></footer></section></div>
    <% purchase.cashbookEntries.forEach((entry) => { %><div class="modal-overlay" id="purchasePaymentEdit<%= entry.id %>" style="display:none" aria-hidden="true" role="dialog" aria-modal="true"><section class="modal-card purchase-edit-payment-modal"><header class="modal-header"><div><p class="eyebrow">Edit supplier payment</p><h2><%= purchase.purchaseNumber %></h2></div><button class="modal-close-btn" type="button" data-purchase-payment-edit-close aria-label="Close">×</button></header><form method="post" action="/purchases/<%= purchase.id %>/payments/<%= entry.id %>"><div class="modal-body payment-editor-fields"><label>Date<input name="entryDate" type="date" value="<%= entry.entryDate %>" required></label><label>Amount<input name="amount" type="number" min="0.01" max="<%= Number(purchase.totalAmount).toFixed(2) %>" step="0.01" value="<%= Number(entry.amount).toFixed(2) %>" required></label><label>Payment method<select name="paymentMethod"><% ['CASH','UPI','CARD','BANK_TRANSFER'].forEach((method) => { %><option value="<%= method %>" <%= entry.paymentMethod === method ? 'selected' : '' %>><%= method.replace('_', ' ') %></option><% }) %></select></label><label>Note<input name="notes" value="<%= entry.notes || '' %>" placeholder="Optional"></label></div><footer class="modal-footer"><button class="button ghost" type="button" data-purchase-payment-edit-close>Cancel</button><button class="button" type="submit">Save payment</button></footer></form></section></div><% }) %>
    <% if (due > 0) { %><div class="modal-overlay" id="purchasePaymentAdd<%= purchase.id %>" style="display:none" aria-hidden="true" role="dialog" aria-modal="true"><section class="modal-card purchase-edit-payment-modal"><header class="modal-header"><div><p class="eyebrow">Supplier payment</p><h2>Record payment</h2><p class="muted">Current due: <%= money(due) %></p></div><button class="modal-close-btn" type="button" data-purchase-payment-add-close aria-label="Close">×</button></header><form method="post" action="/purchases/<%= purchase.id %>/payments"><div class="modal-body payment-editor-fields"><label>Amount<input name="amount" type="number" min="0.01" max="<%= due.toFixed(2) %>" step="0.01" value="<%= due.toFixed(2) %>" required></label><label>Payment method<select name="paymentMethod"><option value="CASH">Cash</option><option value="UPI">UPI</option><option value="CARD">Card</option><option value="BANK_TRANSFER">Bank transfer</option></select></label><label>Payment date<input name="entryDate" type="date" value="<%= dateInput() %>" required></label><label>Note<input name="notes" placeholder="Optional"></label></div><footer class="modal-footer"><button class="button ghost" type="button" data-purchase-payment-add-close>Cancel</button><button class="button" type="submit">Record payment</button></footer></form></section></div><% } %>
    <% } %>
      </div>
    </section>
    <% }) %>
    <% }) %>
  </div><%- include('../_pagination',{pagination}) %>
  <% } else { %><div class="empty-state"><span>▣</span><h3>No supplier purchases found</h3><p>Record a supplier lot here, then use Batch Add Pieces to create one barcode per physical item.</p><a class="button" href="/purchases/new">Record first purchase</a></div><% } %>
</section>
<%- include('../_export_modal', { exportModalId: 'supplierPurchaseExportModal', exportResource: 'supplier-purchases', exportTitle: 'Supplier Purchase', exportFrom: dateInput(), exportTo: dateInput() }) %>
<style>.purchase-register-list{display:grid;gap:16px;margin-top:16px}.supplier-purchase-group{border:1px solid var(--border,#e6dfd3);border-radius:16px;overflow:hidden;background:var(--surface,#fff)}.supplier-purchase-heading{display:flex;align-items:center;justify-content:space-between;gap:18px;padding:14px 18px;background:rgba(193,142,33,.06);border-bottom:1px solid var(--border,#e6dfd3)}.supplier-purchase-heading>div>span,.supplier-purchase-heading small{display:block;color:var(--muted,#70685e);font-size:11px;font-weight:700;letter-spacing:.05em;text-transform:uppercase}.supplier-purchase-heading a{display:inline-block;margin-top:3px;color:inherit;text-decoration:none}.supplier-purchase-heading a:hover{text-decoration:underline}.supplier-purchase-heading strong{font-size:16px}.supplier-purchase-heading>div>small{margin-top:4px;font-weight:400;letter-spacing:0;text-transform:none}.supplier-purchase-totals{display:flex;align-items:flex-end;gap:14px;text-align:right}.supplier-purchase-totals small{letter-spacing:0;text-transform:none;font-weight:400}.supplier-purchase-totals strong{display:block;color:var(--text,#1f1a14);font-size:14px;margin-top:3px}.supplier-purchase-items{display:grid;gap:0}.purchase-register-card{background:var(--surface,#fff);overflow:hidden}.purchase-register-card+.purchase-register-card{border-top:1px solid var(--border,#e6dfd3)}.purchase-card-heading,.purchase-card-actions{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:12px 16px}.purchase-card-heading{border-bottom:1px solid var(--border,#eee)}.purchase-card-heading strong,.purchase-card-block strong{display:block}.purchase-card-heading small,.purchase-card-block small{display:block;color:var(--muted,#70685e);margin-top:3px}.purchase-card-grid{display:grid;grid-template-columns:1.4fr 1fr;gap:18px;padding:16px}.purchase-card-block>span{display:block;color:var(--muted,#70685e);font-size:11px;font-weight:700;letter-spacing:.05em;text-transform:uppercase;margin-bottom:5px}.purchase-card-money{text-align:right}.purchase-card-actions{border-top:1px solid var(--border,#eee);justify-content:flex-end}.purchase-card-actions form{margin:0}.danger-action{color:#b53d36}.purchase-payment-modal{width:min(660px,94vw)}.purchase-edit-payment-modal{width:min(500px,94vw)}.purchase-payment-summary{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;padding:12px;border-radius:10px;background:rgba(193,142,33,.08)}.purchase-payment-summary span{font-size:12px;color:var(--muted,#70685e)}.purchase-payment-summary strong{display:block;color:inherit;font-size:16px;margin-top:3px}.purchase-payment-body h3{font-size:14px;margin:20px 0 8px}.purchase-history-list{display:grid;gap:7px}.purchase-history-row{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:10px 12px;border:1px solid var(--border,#eee);border-radius:9px}.purchase-history-row strong,.purchase-history-row small{display:block}.purchase-history-row small{color:var(--muted,#70685e);margin-top:3px}.purchase-record-button{margin-top:18px}.payment-editor-fields{display:grid;gap:14px}.payment-editor-fields label{display:grid;gap:6px;font-size:12px;font-weight:700;color:var(--muted,#70685e)}@media(max-width:760px){.supplier-purchase-heading,.supplier-purchase-totals{align-items:flex-start;flex-direction:column;text-align:left;gap:8px}.purchase-card-grid{grid-template-columns:1fr;gap:12px}.purchase-card-money{text-align:left}.purchase-card-actions{justify-content:flex-start;flex-wrap:wrap}.purchase-payment-summary{grid-template-columns:1fr}}</style>
<script>(()=>{const bindModal=(openAttribute,closeAttribute)=>{document.querySelectorAll(`[${openAttribute}]`).forEach(button=>{const modal=document.getElementById(button.getAttribute(openAttribute));if(!modal)return;const close=()=>{modal.style.display='none';modal.setAttribute('aria-hidden','true');button.focus()};button.addEventListener('click',()=>{modal.style.display='flex';modal.setAttribute('aria-hidden','false')});modal.querySelectorAll(`[${closeAttribute}]`).forEach(control=>control.addEventListener('click',close));modal.addEventListener('click',event=>{if(event.target===modal)close()});document.addEventListener('keydown',event=>{if(event.key==='Escape'&&modal.style.display==='flex')close()})})};bindModal('data-purchase-manage-open','data-purchase-manage-close');bindModal('data-purchase-payment-edit-open','data-purchase-payment-edit-close');bindModal('data-purchase-payment-add-open','data-purchase-payment-add-close')})();</script>
