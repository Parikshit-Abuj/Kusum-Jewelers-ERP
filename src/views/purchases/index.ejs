<header class="page-header"><div><p class="eyebrow">Incoming stock</p><h1>Purchases</h1><p class="muted">Record supplier bills and add pieces to inventory.</p></div><div class="header-actions"><a class="button ghost" href="/data-management?resource=purchases">Export / archive</a><a class="button" href="/purchases/new">+ Record purchase</a></div></header>
<section class="panel"><div class="panel-heading"><div><h2>Purchase register</h2><p>Most recent 100 supplier bills.</p></div></div><% if (purchases.length) { %><div class="table-wrap"><table><thead><tr><th>Purchase no.</th><th>Supplier</th><th>Date</th><th>Items</th><th>Payment</th><th class="right">Total</th></tr></thead><tbody><% purchases.forEach((purchase) => { %><tr><td><strong><%= purchase.purchaseNumber %></strong></td><td><%= purchase.supplier?.name || 'Unassigned supplier' %></td><td><%= purchase.purchaseDate.toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) %></td><td><%= purchase._count.items %></td><td><span class="pill neutral"><%= purchase.paymentMethod.replace('_', ' ') %></span></td><td class="right"><strong><%= money(purchase.total) %></strong></td></tr><% }) %></tbody></table></div><% } else { %><div class="empty-state"><span>↙</span><h3>No purchases recorded</h3><p>Record stock received from a supplier.</p><a class="button" href="/purchases/new">Record purchase</a></div><% } %></section>
