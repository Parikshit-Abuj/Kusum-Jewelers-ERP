<header class="page-header purchase-form-header"><div><p class="eyebrow">Supplier stock receipt</p><h1>New Purchase Lot</h1><p class="muted">Record the supplier lot first. Add individual barcode pieces later from Inventory.</p></div><a class="button ghost" href="/purchases">Cancel</a></header>
<% if(rateInfo.rate){ %><div class="rate-notice purchase-rate-notice"><strong>Today’s reference rates</strong><span>22K <%-money(rateInfo.rate.gold22k)%>/g · 24K <%-money(rateInfo.rate.gold24k)%>/g · Silver <%-money(rateInfo.rate.silver)%>/g</span></div><% } %>
<form class="panel form-panel purchase-form" method="post" action="/purchases" data-supplier-purchase-form>
  <section class="form-section">
    <div class="purchase-section-title"><div><h2>1. Supplier</h2><p>Choose an existing supplier or enter a new name.</p></div></div>
    <div class="form-grid purchase-supplier-core"><label>Purchase date *<input name="purchaseDate" type="date" required value="<%=dateInput()%>"></label><label class="purchase-supplier-name">Supplier name *<input name="supplierName" required autocomplete="off" data-supplier-name placeholder="Supplier / firm name"></label><label>Mobile number<input name="supplierPhone" inputmode="numeric" maxlength="15" placeholder="Optional"></label></div>
    <div class="supplier-suggestions" data-supplier-suggestions hidden></div>
    <label class="purchase-different-supplier"><input name="confirmDifferentSupplier" type="checkbox" value="yes"> This is a different supplier</label>
    <details class="purchase-optional-details"><summary>More supplier details <span>GSTIN, PAN, email and address</span></summary><div class="form-grid four purchase-extra-fields"><label>GSTIN<input name="supplierGstin" maxlength="20" placeholder="Optional"></label><label>PAN<input name="supplierPan" maxlength="20" placeholder="Optional"></label><label>Email<input name="supplierEmail" type="email" placeholder="Optional"></label><label>Address<input name="supplierAddress" placeholder="Optional"></label></div></details>
  </section>
  <section class="form-section">
    <div class="purchase-section-title"><div><h2>2. Lot received</h2><p>Enter the total pieces and total weight on the supplier bill.</p></div></div>
    <div class="form-grid four"><label>Item name *<input name="itemName" required data-title-case placeholder="e.g. Gold Earring"></label><label>Category *<input name="category" required data-title-case placeholder="e.g. Earring"></label><label>Metal *<select name="metal" data-purchase-metal><option value="GOLD">Gold</option><option value="SILVER">Silver</option></select></label><label>Purity<input name="purity" data-purchase-purity placeholder="e.g. 22K, 925, 99.9"></label><label>Pieces received *<input name="quantity" required type="number" min="1" step="1" value="1" placeholder="e.g. 54"></label><label>Gross weight (g)<input name="grossWeight" type="number" min="0" step="0.001" data-purchase-gross placeholder="56.600"></label><label>Stone weight (g)<input name="stoneWeight" type="number" min="0" step="0.001" value="0" placeholder="0.000"></label><label>Net weight (g) *<input name="netWeight" required type="number" min="0.001" step="0.001" data-purchase-net placeholder="56.600"></label></div>
  </section>
  <section class="form-section">
    <div class="purchase-section-title"><div><h2>3. Amount & payment</h2><p>Pay now or leave the remaining balance as supplier due.</p></div></div>
    <div class="form-grid four"><label>Purchase rate / gram (₹) *<input name="ratePerGram" required type="number" min="0.01" step="0.01" data-purchase-rate data-rate-22="<%=rateInfo.rate?Number(rateInfo.rate.gold22k):0%>" data-rate-24="<%=rateInfo.rate?Number(rateInfo.rate.gold24k):0%>" data-rate-silver="<%=rateInfo.rate?Number(rateInfo.rate.silver):0%>" placeholder="0.00"></label><div class="rate-readout accent"><span>Weight × rate</span><strong data-purchase-total>₹0.00</strong><small>Suggested purchase amount</small></div><label>Purchase amount (₹) *<input name="totalAmount" required type="number" min="0.01" step="0.01" data-purchase-amount placeholder="0.00"></label><label>Paid now (₹)<input name="paid" type="number" min="0" step="0.01" data-purchase-paid placeholder="0.00"></label><label>Payment method<select name="paymentMethod"><option value="CASH">Cash</option><option value="UPI">UPI</option><option value="CARD">Card</option><option value="BANK_TRANSFER">Bank transfer</option></select></label><label>Supplier bill / reference<input name="reference" placeholder="Optional"></label></div>
    <details class="purchase-optional-details purchase-note-details"><summary>Add a note <span>Optional purchase remark</span></summary><label>Notes<textarea name="notes" rows="2" placeholder="Optional"></textarea></label></details>
  </section>
  <footer class="form-footer"><a class="button ghost" href="/purchases">Cancel</a><button class="button" type="submit">Save purchase lot</button></footer>
</form>
<style>.purchase-form-header .muted{margin-top:5px}.purchase-rate-notice{margin-bottom:14px}.purchase-section-title{display:flex;align-items:center;justify-content:space-between;margin-bottom:14px}.purchase-section-title h2{margin:0;font-size:17px}.purchase-section-title p{margin:4px 0 0;color:var(--muted,#70685e);font-size:13px}.purchase-supplier-core{grid-template-columns:180px minmax(260px,1fr) 220px}.purchase-supplier-name{min-width:0}.purchase-different-supplier{display:inline-flex;align-items:center;gap:7px;margin-top:11px;color:var(--muted,#70685e);font-size:12px;cursor:pointer}.purchase-different-supplier input{width:auto;min-height:auto;margin:0}.purchase-optional-details{margin-top:14px;padding:11px 13px;border:1px solid var(--border,#e6dfd3);border-radius:10px;background:rgba(193,142,33,.035)}.purchase-optional-details summary{cursor:pointer;font-size:13px;font-weight:700}.purchase-optional-details summary span{margin-left:7px;color:var(--muted,#70685e);font-size:12px;font-weight:400}.purchase-extra-fields{margin-top:13px}.purchase-note-details>label{display:grid;gap:6px;margin-top:12px;font-size:12px;font-weight:700;color:var(--muted,#70685e)}@media(max-width:760px){.purchase-supplier-core{grid-template-columns:1fr}.purchase-section-title{align-items:flex-start}.purchase-optional-details summary span{display:block;margin:3px 0 0}}</style>
<script>(()=>{const f=document.querySelector('[data-supplier-purchase-form]');if(!f)return;const q=s=>f.querySelector(s),n=v=>Number(v.value||0),metal=q('[data-purchase-metal]'),purity=q('[data-purchase-purity]'),rate=q('[data-purchase-rate]'),net=q('[data-purchase-net]'),gross=q('[data-purchase-gross]'),amount=q('[data-purchase-amount]'),paid=q('[data-purchase-paid]'),total=q('[data-purchase-total]');let paidEdited=false;function calc(){const value=n(net)*n(rate);amount.value=value.toFixed(2);if(!paidEdited)paid.value=value.toFixed(2);total.textContent='₹'+value.toLocaleString('en-IN',{minimumFractionDigits:2,maximumFractionDigits:2});}function setRate(){const p=(purity.value||'').trim().toUpperCase();const v=metal.value==='SILVER'?rate.dataset.rateSilver:p==='24K'?rate.dataset.rate24:rate.dataset.rate22;if(Number(v)>0)rate.value=Number(v).toFixed(2);calc();}gross.addEventListener('input',()=>{net.value=gross.value;calc()});[net,rate].forEach(e=>e.addEventListener('input',calc));paid.addEventListener('input',()=>paidEdited=true);metal.addEventListener('change',setRate);purity.addEventListener('input',setRate);setRate();const name=q('[data-supplier-name]'), box=q('[data-supplier-suggestions]');let timer,controller;name.addEventListener('input',()=>{clearTimeout(timer);const term=name.value.trim();if(term.length<2){box.hidden=true;return}timer=setTimeout(async()=>{controller?.abort();controller=new AbortController();try{const r=await fetch('/api/suppliers/search?q='+encodeURIComponent(term),{signal:controller.signal});const d=await r.json();box.replaceChildren(...(d.suppliers||[]).map(s=>{const b=document.createElement('button');b.type='button';b.textContent=`${s.name}${s.phone?' · '+s.phone:''}`;b.onclick=()=>{name.value=s.name;q('[name=supplierPhone]').value=s.phone||'';q('[name=supplierEmail]').value=s.email||'';q('[name=supplierAddress]').value=s.address||'';q('[name=supplierGstin]').value=s.gstin||'';q('[name=supplierPan]').value=s.panNumber||'';box.hidden=true};return b}));box.hidden=!(d.suppliers||[]).length}catch(e){if(e.name!=='AbortError')box.hidden=true}},220)})})();</script>
