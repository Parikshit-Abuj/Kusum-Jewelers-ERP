<header class="page-header"><div><p class="eyebrow">Incoming stock</p><h1>Record purchase</h1><p class="muted">Use this for additional quantities of an existing jewellery item.</p></div><a class="button ghost" href="/purchases">Cancel</a></header>
<% if (!products.length) { %><section class="panel empty-state"><span>◇</span><h3>Add an item first</h3><p>Purchases increase the quantity of existing inventory items.</p><a class="button" href="/inventory/new">Add jewellery item</a></section><% } else { %>
<form class="transaction-layout" method="post" action="/purchases" data-transaction-form data-purchase-form>
  <section class="panel transaction-main"><div class="form-grid three compact-fields"><label>Purchase no.<input name="purchaseNumber" required value="<%= purchaseNumber %>"></label><label>Date<input name="purchaseDate" type="date" value="<%= dateInput() %>"></label><label>Supplier<select name="supplierId"><option value="">Select supplier (optional)</option><% suppliers.forEach((supplier) => { %><option value="<%= supplier.id %>"><%= supplier.name %></option><% }) %></select></label></div>
    <div class="line-items-header"><div><h2>Stock received</h2><p>Choose an item to increase its available quantity.</p></div><button class="button secondary small" type="button" data-add-row>+ Add item</button></div><div class="line-items" data-rows></div>
    <template data-line-template><div class="line-item" data-line-item><div class="line-number">1</div><label class="product-field">Item<select name="productId" required data-product-select><option value="">Select jewellery item</option><% products.forEach((product) => { %><option value="<%= product.id %>" data-sale-price="<%= product.purchasePrice %>" data-making-charge="0" data-label="<%= product.sku %>"><%= product.sku %> · <%= product.name %></option><% }) %></select></label><label>Qty<input name="quantity" type="number" min="1" value="1" required data-quantity></label><label>Unit cost (₹)<input name="unitPrice" type="number" step="0.01" min="0" required data-unit-price></label><input type="hidden" name="makingCharge" value="0" data-making-charge><div class="line-total"><small>Line total</small><strong data-line-total>₹0.00</strong></div><button class="remove-row" type="button" title="Remove item" data-remove-row>×</button></div></template>
    <label class="notes-label">Notes<textarea name="notes" rows="3" placeholder="Supplier bill number or any purchase note"></textarea></label></section>
  <aside class="panel transaction-summary"><h2>Payment summary</h2><div class="summary-row"><span>Subtotal</span><strong data-subtotal>₹0.00</strong></div><label class="summary-input">Discount (₹)<input name="discount" type="number" min="0" step="0.01" value="0" data-discount></label><input type="hidden" name="gstRate" value="0" data-gst-rate><div class="summary-total"><span>Purchase total</span><strong data-total>₹0.00</strong></div><hr><label class="summary-input">Paid now (₹)<input name="paid" type="number" min="0" step="0.01" value="0" data-paid></label><label class="summary-input">Payment method<select name="paymentMethod" data-payment-method><% ['CASH','UPI','CARD','BANK_TRANSFER','CREDIT','MIXED'].forEach((method) => { %><option value="<%= method %>"><%= method.replace('_', ' ') %></option><% }) %></select></label><label class="cashbook-sync" data-cashbook-sync-control><input type="checkbox" name="syncCashbook" checked> Add payment to Daily Cashbook</label><button class="button full large" type="submit">Save purchase</button><p class="form-hint">Saving increases stock and records a purchase movement. Daily Cashbook sync is optional for cash, UPI, card and bank transfer.</p></aside>
</form><% } %>
