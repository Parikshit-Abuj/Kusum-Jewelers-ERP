<header class="page-header">
  <div><p class="eyebrow">Shared shop data</p><h1>Network PC setup</h1></div>
  <button class="button ghost" type="button" data-connection-repair-open>Change connection</button>
</header>

<% if (!canEnableSharing) { %>
  <article class="panel"><div class="empty-state compact"><span>i</span><h3>Client PC</h3><p>Connected to main database at <strong><%= connection.host %>:<%= connection.port %></strong>.</p></div></article>
<% } else { %>
  <section class="content-grid two-thirds">
    <article class="panel">
      <div class="panel-heading"><div><h2>Enable client PCs</h2></div></div>
      <form method="post" action="/network-setup" class="stack-form">
        <div class="form-grid two compact-fields">
          <label>Database name<input value="<%= connection.database %>" disabled></label>
          <label>MySQL port<input value="<%= connection.port %>" disabled></label>
        </div>
        <div class="form-grid two compact-fields">
          <label>MySQL admin user<input name="mysqlUser" type="text" required value="root" autocomplete="username" class="preserve-case" data-no-uppercase autocapitalize="none" spellcheck="false"></label>
          <label>MySQL admin password<input name="mysqlPassword" type="password" autocomplete="current-password" placeholder="Leave blank if none" class="preserve-case" data-no-uppercase></label>
        </div>
        <div class="form-grid two compact-fields">
          <label>Shared ERP username<input name="databaseUser" type="text" required value="kusum_erp_shared" minlength="3" autocomplete="off" class="preserve-case" data-no-uppercase autocapitalize="none" spellcheck="false"></label>
          <label>Shared ERP password<input name="databasePassword" type="password" required autocomplete="new-password" class="preserve-case" data-no-uppercase></label>
        </div>
        <button class="button" type="submit">Save client PC access</button>
      </form>
    </article>
    <aside class="panel network-info">
      <h2>Main PC LAN IP</h2>
      <% if (addresses.length) { %><div class="network-addresses"><% addresses.forEach((address) => { %><code><%= address %></code><% }) %></div><% } else { %><p class="muted">No LAN address detected.</p><% } %>
    </aside>
  </section>
<% } %>

<div class="modal-overlay connection-repair-modal" id="connectionRepairModal" style="display: none;" role="dialog" aria-modal="true" aria-labelledby="connectionRepairModalTitle" aria-hidden="true">
  <section class="modal-card" role="document">
    <header class="modal-header">
      <div>
        <p class="eyebrow">Confirm change</p>
        <h2 id="connectionRepairModalTitle">Change ERP connection?</h2>
      </div>
      <button class="modal-close-btn" type="button" data-connection-repair-close aria-label="Close confirmation">&times;</button>
    </header>
    <div class="modal-body">
      <p class="muted">Continue only when the database server, port, database name, or login details have changed.</p>
    </div>
    <footer class="modal-footer connection-repair-modal-footer">
      <button class="button ghost" type="button" data-connection-repair-close>Cancel</button>
      <a class="button danger" href="/connection-repair">Continue</a>
    </footer>
  </section>
</div>
