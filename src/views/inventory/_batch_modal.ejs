<!-- Batch Inventory Piece Addition Modal -->
<div class="modal-overlay" id="batchPieceModal" style="display:none;" aria-hidden="true">
  <div class="modal-card batch-modal-card split-layout">
    <header class="modal-header batch-header-with-doc">
      <div class="batch-header-title">
        <div class="batch-badge">FAST-TRACK BATCH ENTRY</div>
        <h2>Batch Add Jewellery Pieces</h2>
      </div>

      <div class="batch-doc-toolbar">
        <div class="batch-doc-field">
          <span>Batch Doc No:</span>
          <input type="text" id="batchDocNoInput" readonly value="" placeholder="Assigned on first piece" title="A unique batch document number is assigned when the first piece is saved.">
        </div>
        <button type="button" class="button ghost small" id="batchNewDocBtn">+ New Batch</button>
        <button type="button" class="button secondary small" id="batchLoadDocBtn">Load Batch</button>
        <button type="button" class="button ghost small" id="batchRefreshBtn" title="Refresh pieces from database">Refresh</button>
        <button type="button" class="modal-close-btn" data-batch-modal-close aria-label="Close modal">✕</button>
      </div>
    </header>

    <div class="modal-body batch-split-body">
      <!-- Left Column: Item Template & Rapid Weight Entry -->
      <div class="batch-left-col">
        <!-- Section 1: Item Template (Configured Once) -->
        <div class="batch-config-panel">
          <div class="batch-section-title">
            <span>1</span>
            <strong>Item Template</strong>
          </div>
          <div class="form-grid two compact-fields">
            <label>
              <span>Item Name *</span>
              <div class="autocomplete-wrap">
                <input type="text" id="batchItemName" placeholder="e.g. Silver Payal Chain" autocomplete="off" data-batch-name-input data-title-case required>
                <ul class="autocomplete-list" data-batch-name-list></ul>
              </div>
            </label>
            <label>
              <span>Category *</span>
              <input type="text" id="batchCategory" placeholder="e.g. Payal, Ring, Chain" data-batch-category-input data-title-case required>
            </label>
          </div>

          <div class="form-grid two compact-fields" style="margin-top: 5px;">
            <label>
              <span>Metal *</span>
              <select id="batchMetal" data-batch-metal>
                <option value="GOLD">Gold</option>
                <option value="SILVER" selected>Silver</option>
                <option value="PLATINUM">Platinum</option>
                <option value="OTHER">Other</option>
              </select>
            </label>
            <label>
              <span>Purity (optional)</span>
              <select id="batchPurity" data-batch-purity>
                <option value="" selected>Not specified</option>
              </select>
            </label>
          </div>

          <div class="form-grid two compact-fields" style="margin-top: 5px;">
            <label>
              <span>Making Type</span>
              <select id="batchMakingType" data-batch-making-type>
                <option value="PER_GRAM" selected>Per Gram (₹ / g)</option>
                <option value="FIXED">Fixed per Piece (₹)</option>
                <option value="PERCENTAGE">Percentage (%)</option>
              </select>
            </label>
            <label>
              <span>Making Charge *</span>
              <input type="number" id="batchMakingValue" min="0" step="0.01" value="0" placeholder="e.g. 15 or 10%" data-batch-making-value required>
            </label>
          </div>

          <div class="form-grid two compact-fields" style="margin-top: 5px;">
            <label>
              <span>Location / Tray</span>
              <input type="text" id="batchLocation" placeholder="e.g. Tray 1, Shelf B" data-batch-location>
            </label>
            <div class="batch-rate-indicator-box">
              <span>Live Rate</span>
              <div class="batch-rate-indicator" data-batch-rate-badge>
                <span class="dot">●</span>
                <span data-batch-rate-text>₹0.00/g</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Section 2: Rapid Weight Stream Entry & In-Popup Edit -->
        <div class="batch-entry-panel" id="batchEntryPanel">
          <div class="batch-section-title">
            <span>2</span>
            <strong id="batchEntryTitle">Weight Entry</strong>
          </div>

          <div class="batch-editing-banner" id="batchEditingBanner" style="display:none;">
            <span>Editing: <strong id="batchEditingBarcode">S 00001</strong></span>
            <button type="button" class="button ghost small" id="batchCancelEditBtn" style="padding:2px 8px;font-size:11px;">Cancel ✕</button>
          </div>

          <form id="batchWeightForm" class="batch-weight-form" onsubmit="return false;">
            <input type="hidden" id="batchEditingId" value="">
            <div class="weight-input-group">
              <label class="weight-label primary-weight">
                <span>Gross Wt (g) *</span>
                <input type="number" id="batchGrossWeight" step="0.001" min="0.001" placeholder="0.000" required autocomplete="off" autofocus data-batch-gross-weight>
              </label>
              <label class="weight-label">
                <span>Stone Wt (g)</span>
                <input type="number" id="batchStoneWeight" step="0.001" min="0" value="0" placeholder="0.000" autocomplete="off" data-batch-stone-weight>
              </label>
              <label class="weight-label primary-weight">
                <span>Net Wt (g) *</span>
                <input type="number" id="batchNetWeight" step="0.001" min="0.001" placeholder="0.000" required autocomplete="off" data-batch-net-weight>
              </label>
            </div>
            <div style="margin-top: 10px; display: flex; gap: 8px;">
              <button type="submit" class="button accent batch-add-btn" id="batchAddPieceBtn" data-batch-add-btn style="flex:1;">
                + Add Piece ↵
              </button>
            </div>
            <div class="batch-live-hint">
              <span id="batchFeedback" class="batch-feedback" style="display:none;"></span>
            </div>
          </form>
        </div>
      </div>

      <!-- Right Column: Added Pieces Table & Direct Barcode Printing -->
      <div class="batch-right-col">
        <div class="batch-results-panel full-height">
          <div class="batch-results-header">
            <div class="batch-stats-summary">
              <strong>Batch Pieces: <span class="highlight" data-batch-stats-count>0</span></strong>
              <span class="stat-sep">·</span>
              <span>Wt: <strong data-batch-stats-weight>0.000</strong> g</span>
              <span class="stat-sep">·</span>
              <span>Val: <strong data-batch-stats-value>₹0.00</strong></span>
            </div>
            <div class="batch-print-actions">
              <button type="button" class="button ghost small" data-batch-clear-list title="Clear screen list">Clear</button>
            </div>
          </div>

          <div class="table-wrap batch-table-wrap fill-space">
            <table class="batch-items-table">
              <thead>
                <tr>
                  <th class="label-select" style="width:32px;">
                    <input type="checkbox" data-batch-select-all checked title="Select all barcodes">
                  </th>
                  <th style="width:75px;">Barcode</th>
                  <th>Item Name</th>
                  <th style="width:55px;">Metal</th>
                  <th class="right" style="width:70px;">Net Wt</th>
                  <th style="width:55px;">Making</th>
                  <th class="right" style="width:80px;">Value</th>
                  <th class="center" style="width:65px;">Status</th>
                  <th class="center" style="width:75px;">Action</th>
                </tr>
              </thead>
              <tbody data-batch-items-tbody>
                <tr class="batch-empty-row">
                  <td colspan="9" class="center muted" style="padding: 36px 16px;">
                    No pieces in this Batch Document yet.<br>Enter Gross Weight on the left and press <strong>Enter ↵</strong> to add!
                  </td>
                </tr>
              </tbody>
            </table>
          </div>

          <div class="batch-right-footer" style="background:#fffcf7; border: 1.5px solid #ebd9c4; border-radius: 12px; padding: 12px 18px; margin-top: 10px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px;">
            <div style="display: flex; align-items: center; gap: 10px; flex-wrap: wrap;">
              <strong data-batch-selected-count style="font-size: 12.5px; padding: 3px 8px; border-radius: 6px; background: #f0ebe0; color: #5a4933; font-weight: 750;">0 selected</strong>
              <span style="font-size: 12px; color: #4a3e31;">
                Printer Queue: <strong><%= typeof printerName !== 'undefined' && printerName ? printerName : 'TSC TTP-244 Pro' %></strong>
              </span>
              <button type="button" class="button ghost small" id="batchCheckPrinterBtn" style="padding: 2px 8px; font-size: 11px; font-weight: 700;">Check Printer</button>
            </div>

            <div style="display: flex; align-items: center; gap: 10px; flex-wrap: wrap;">
              <input type="hidden" name="batchPrinterName" value="<%= typeof printerName !== 'undefined' ? printerName : 'TSC TTP-244 Pro' %>">

              <button type="button" class="button accent" id="batchPrintBtnFooter" data-batch-print-tspl disabled style="background: #b47a21; color: #fff; border: none; font-weight: 750; padding: 8px 18px; border-radius: 8px; box-shadow: 0 2px 8px rgba(180,122,33,0.25); cursor: pointer; font-size: 13px;">
                Send to <%= typeof printerName !== 'undefined' && printerName ? printerName : 'TSC TTP-244 Pro' %>
              </button>

              <button type="button" class="button secondary" data-batch-close-refresh style="padding: 8px 18px; border-radius: 8px; font-weight: 700; font-size: 13px;">
                Done (Close)
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Modal: Load Previous Batch Document -->
<div class="modal-overlay" id="batchLoadDocModal" style="display:none; z-index:10001;" aria-hidden="true">
  <div class="modal-card" style="max-width: 820px; background: #ffffff !important;">
    <header class="modal-header" style="background: #faf8f5; border-bottom: 1px solid #e8dfcf;">
      <div>
        <h2 style="font-size: 18px; margin: 0; color: #1a1612;">Load Batch Document</h2>
        <p style="font-size: 12px; color: #7d7265; margin: 2px 0 0;">Select a previous batch document to continue adding pieces or print labels</p>
      </div>
      <button type="button" class="modal-close-btn" id="batchLoadDocCloseBtn">✕</button>
    </header>
    <div class="modal-body" style="max-height: 60vh; overflow-y: auto; background: #ffffff; padding: 16px 20px;">
      <div class="table-wrap" style="border: 1px solid #eee6d8; border-radius: 10px; background: #ffffff;">
        <table class="inventory-table" style="background: #ffffff; width: 100%;">
          <thead>
            <tr style="background: #faf6ef;">
              <th style="padding: 10px 12px; font-size: 11px; color: #635647; text-transform: uppercase;">Batch Doc No</th>
              <th style="padding: 10px 12px; font-size: 11px; color: #635647; text-transform: uppercase;">Item / Metal</th>
              <th class="right" style="padding: 10px 12px; font-size: 11px; color: #635647; text-transform: uppercase;">Pieces</th>
              <th class="right" style="padding: 10px 12px; font-size: 11px; color: #635647; text-transform: uppercase;">Total Weight</th>
              <th class="right" style="padding: 10px 12px; font-size: 11px; color: #635647; text-transform: uppercase;">Total Value</th>
              <th class="center" style="padding: 10px 12px; font-size: 11px; color: #635647; text-transform: uppercase;">Action</th>
            </tr>
          </thead>
          <tbody id="batchDocListTbody" style="background: #ffffff;">
            <tr><td colspan="6" class="center muted" style="padding: 24px; background: #ffffff;">Loading batch documents...</td></tr>
          </tbody>
        </table>
      </div>
    </div>
    <footer class="modal-footer" style="background: #faf8f5; border-top: 1px solid #e8dfcf; padding: 12px 20px; justify-content: flex-end;">
      <button type="button" class="button ghost" id="batchLoadDocCancelBtn">Cancel</button>
    </footer>
  </div>
</div>
