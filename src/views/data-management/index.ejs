<header class="page-header">
  <div>
    <p class="eyebrow">Data Lifecycle &amp; Compliance</p>
    <h1>Data Exports &amp; Archiving</h1>
    <p class="muted">Download multi-sheet Excel (.xlsx) workbooks for CA audits and tax filings, or manage historical records.</p>
  </div>
  <div class="header-actions">
    <button class="button ghost small" type="button" data-archive-modal-open>
      🛡️ Controlled Archival
    </button>
  </div>
</header>

<!-- Main Clean 2-Column Grid -->
<div class="data-mgmt-grid">
  
  <!-- Left Panel: Excel Export Console -->
  <article class="panel export-panel">
    <div class="panel-heading">
      <div>
        <h2>Export to Excel (.xlsx)</h2>
        <p class="muted">Generate complete, audit-ready spreadsheet workbooks with native formulas and totals.</p>
      </div>
    </div>

    <form method="post" action="/data/export" id="exportForm" class="export-form">
      
      <!-- Register Selector -->
      <div class="clean-form-group">
        <label for="exportResourceSelect" class="clean-field-label">
          <span>Select Register</span>
        </label>
        <select name="resource" id="exportResourceSelect" class="clean-select">
          <% resources.forEach((item) => { %>
          <option value="<%= item.key %>" <%= selectedResource === item.key ? 'selected' : '' %>>
            <%= item.label %> &nbsp;—&nbsp; <%= item.dateLabel %>
          </option>
          <% }) %>
        </select>
      </div>

      <!-- Accounting Period Presets & Dates -->
      <div class="clean-form-group">
        <label class="clean-field-label">
          <span>Accounting Period</span>
        </label>
        
        <!-- Clean Presets Pill Row -->
        <div class="period-presets-bar">
          <button type="button" class="preset-pill" data-preset="today">Today</button>
          <button type="button" class="preset-pill is-active" data-preset="thisMonth">This Month</button>
          <button type="button" class="preset-pill" data-preset="lastMonth">Last Month</button>
          <button type="button" class="preset-pill" data-preset="fy">Current FY</button>
          <button type="button" class="preset-pill" data-preset="twoYears">Last 2 Years</button>
        </div>

        <div class="form-grid two clean-date-grid">
          <label class="pos-field">
            <span>From Date</span>
            <input name="from" id="exportFromDate" type="date" required value="<%= range.from %>">
          </label>
          <label class="pos-field">
            <span>To Date</span>
            <input name="to" id="exportToDate" type="date" required value="<%= range.to %>">
          </label>
        </div>
      </div>

      <div class="export-btn-wrap">
        <button class="button gold-btn full-width" type="submit">
          📥 Download Excel (.xlsx) Report
        </button>
      </div>
    </form>
  </article>

  <!-- Right Panel: Retention & Safeguards Hub -->
  <aside class="panel safeguards-panel">
    <div class="panel-heading">
      <div>
        <h2>Retention &amp; Safeguards</h2>
        <p class="muted">Automated integrity protections for showroom compliance.</p>
      </div>
    </div>

    <!-- Clean, Sleek Policy Summary -->
    <ul class="safeguards-list">
      <li>
        <span class="bullet-dot">●</span>
        <div>
          <strong>7-Year IT Act Retention</strong>
          <p>Indian Income Tax Act requires preserving primary sales, invoices, and cashbooks for at least 7 assessment years.</p>
        </div>
      </li>
      <li>
        <span class="bullet-dot">●</span>
        <div>
          <strong>Referential Lock Engine</strong>
          <p>Invoices with open credit dues, customer balances, and active pawn loans cannot be purged.</p>
        </div>
      </li>
      <li>
        <span class="bullet-dot">●</span>
        <div>
          <strong>Active Stock Protection</strong>
          <p>Only zero-stock archived records can ever be removed. All active jewelry in stock trays is strictly preserved.</p>
        </div>
      </li>
      <li>
        <span class="bullet-dot">●</span>
        <div>
          <strong>Permanent Audit Registers</strong>
          <p>Cancelled bills, customer ledgers, and savings schemes remain permanent audit history.</p>
        </div>
      </li>
    </ul>

    <!-- Clean Archival Trigger Box -->
    <div class="archival-trigger-card">
      <div class="archival-trigger-text">
        <strong>Need to purge obsolete historical data?</strong>
        <p class="muted">Requires verified backup confirmation and explicit typing of DELETE.</p>
      </div>
      <button class="button danger small" type="button" data-archive-modal-open>
        Open Archival Console →
      </button>
    </div>
  </aside>

</div>

<!-- Controlled Archival Modal Popup -->
<div class="modal-overlay archival-modal" id="archiveModal" style="display: none;" role="dialog" aria-modal="true" aria-labelledby="archiveModalTitle" aria-hidden="true">
  <section class="modal-card archive-modal-card" role="document">
    <header class="modal-header">
      <div>
        <p class="eyebrow" style="color:#ef4444 !important;">Data Lifecycle · Permanent Purge</p>
        <h2 id="archiveModalTitle">Controlled Archival</h2>
      </div>
      <button class="modal-close-btn" type="button" data-archive-modal-close aria-label="Close controlled archival">&times;</button>
    </header>

    <form method="post" action="/data/archive" data-archive-form>
      <div class="modal-body archival-modal-body">
        <div class="pos-field" style="margin-bottom: 14px;">
          <label>Select Register to Purge</label>
          <select name="resource" data-resource-select class="archive-resource-select">
            <% resources.forEach((item) => { %>
            <option value="<%= item.key %>" data-archive-disabled="<%= item.archiveDisabled ? 'true' : 'false' %>" data-archive-note="<%= item.archiveNote %>" <%= selectedResource === item.key ? 'selected' : '' %>>
              <%= item.label %>
            </option>
            <% }) %>
          </select>
        </div>

        <div class="form-grid two" style="margin-bottom: 14px;">
          <label class="pos-field">
            <span>From Date</span>
            <input name="from" type="date" required value="<%= range.from %>">
          </label>
          <label class="pos-field">
            <span>To Date</span>
            <input name="to" type="date" required value="<%= range.to %>">
          </label>
        </div>

        <!-- Dynamic Rule Banner -->
        <div class="archive-rule-banner" style="margin-bottom: 16px; padding: 12px 14px; border-left: 3px solid #f5c042; background: rgba(245, 192, 66, 0.08); border-radius: 6px;">
          <span class="archive-rule-label" style="font-size: 11px; font-weight: 750; text-transform: uppercase; color: #f5c042; display: block; margin-bottom: 3px;">Active Safety Rule:</span>
          <p class="archive-rule" id="archiveRuleNoteText" style="margin: 0; font-size: 12px; line-height: 1.45;"><%= resource.archiveNote %></p>
        </div>

        <!-- Safety Confirmation Step 1 -->
        <label class="archive-check" style="display: flex; align-items: flex-start; gap: 10px; margin-bottom: 14px; cursor: pointer;">
          <input name="archiveAcknowledged" type="checkbox" style="width: auto; margin-top: 3px;">
          <span style="font-size: 12.5px; font-weight: 600;">I have downloaded an Excel backup and confirm permanently deleting these records.</span>
        </label>

        <!-- Safety Confirmation Step 2 -->
        <label class="pos-field archive-confirm-label" style="margin-bottom: 6px;">
          <span>Type <strong style="color: #ef4444;">DELETE</strong> to confirm permanent deletion:</span>
          <input name="archiveConfirm" autocomplete="off" placeholder="DELETE" class="archive-confirm-input" style="font-weight: 700; letter-spacing: 0.05em;">
        </label>
      </div>
      <footer class="modal-footer archival-modal-footer">
        <button class="button ghost" type="button" data-archive-modal-close>Cancel</button>
        <button class="button danger full" type="submit" data-archive-submit <%= resource.archiveDisabled ? 'disabled' : '' %>>
          Permanently Delete Selected Records
        </button>
      </footer>
    </form>
  </section>
</div>

<script>
(function() {
  const fromInput = document.getElementById('exportFromDate');
  const toInput = document.getElementById('exportToDate');
  
  function formatDate(d) {
    const pad = (value) => String(value).padStart(2, '0');
    return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;
  }

  // Preset date chips
  const presetPills = document.querySelectorAll('.preset-pill');
  presetPills.forEach((btn) => {
    btn.addEventListener('click', () => {
      presetPills.forEach(b => b.classList.remove('is-active'));
      btn.classList.add('is-active');

      const preset = btn.dataset.preset;
      const now = new Date();
      let fromDate, toDate;

      if (preset === 'today') {
        fromDate = new Date(now);
        toDate = new Date(now);
      } else if (preset === 'thisMonth') {
        fromDate = new Date(now.getFullYear(), now.getMonth(), 1);
        toDate = new Date(now);
      } else if (preset === 'lastMonth') {
        fromDate = new Date(now.getFullYear(), now.getMonth() - 1, 1);
        toDate = new Date(now.getFullYear(), now.getMonth(), 0);
      } else if (preset === 'fy') {
        const fyYear = (now.getMonth() >= 3) ? now.getFullYear() : now.getFullYear() - 1;
        fromDate = new Date(fyYear, 3, 1);
        toDate = new Date(fyYear + 1, 2, 31);
      } else if (preset === 'twoYears') {
        fromDate = new Date(now);
        fromDate.setDate(fromDate.getDate() - 730);
        toDate = new Date(now);
      }

      if (fromDate && toDate && fromInput && toInput) {
        fromInput.value = formatDate(fromDate);
        toInput.value = formatDate(toDate);
      }
    });
  });

  // Archival register selector dynamic rule update
  const archiveForm = document.querySelector('[data-archive-form]');
  if (archiveForm) {
    const select = archiveForm.querySelector('[data-resource-select]');
    const submit = archiveForm.querySelector('[data-archive-submit]');
    const note = document.getElementById('archiveRuleNoteText');

    function update() {
      const option = select.options[select.selectedIndex];
      if (!option) return;
      const disabled = option.dataset.archiveDisabled === 'true';
      if (submit) submit.disabled = disabled;
      if (note) note.textContent = option.dataset.archiveNote || '';
    }

    select.addEventListener('change', update);
    update();
  }

  // Modal open/close handlers
  const archiveModal = document.getElementById('archiveModal');
  const archiveOpeners = document.querySelectorAll('[data-archive-modal-open]');
  if (archiveModal && archiveOpeners.length) {
    let archiveTrigger = null;
    const closeArchiveModal = () => {
      archiveModal.style.display = 'none';
      archiveModal.setAttribute('aria-hidden', 'true');
      archiveTrigger?.focus();
    };

    archiveOpeners.forEach(opener => {
      opener.addEventListener('click', () => {
        archiveTrigger = opener;
        archiveModal.style.display = 'flex';
        archiveModal.setAttribute('aria-hidden', 'false');
        window.setTimeout(() => archiveModal.querySelector('[data-resource-select]')?.focus(), 0);
      });
    });

    archiveModal.querySelectorAll('[data-archive-modal-close]').forEach((button) => {
      button.addEventListener('click', closeArchiveModal);
    });

    archiveModal.addEventListener('click', (event) => {
      if (event.target === archiveModal) closeArchiveModal();
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && archiveModal.style.display !== 'none') closeArchiveModal();
    });
  }
})();
</script>
