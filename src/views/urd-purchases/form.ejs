<header class="page-header">
  <div><p class="eyebrow">Old gold / silver buying</p><h1>New URD purchase</h1></div>
  <a class="button ghost" href="/urd-purchases">Cancel</a>
</header>
<% if (rateInfo.rate) { %>
<div class="rate-notice"><strong>Rates in use: <%= rateInfo.sourceDate %></strong><span>22K <%- money(rateInfo.rate.gold22k) %>/g · 24K <%- money(rateInfo.rate.gold24k) %>/g · Silver <%- money(rateInfo.rate.silver) %>/g</span></div>
<% } %>
<form class="panel form-panel" method="post" action="/urd-purchases" data-urd-form>
  <section class="form-section"><h2>Purchase details</h2><div class="form-grid four">
    <label>URD No.<input name="purchaseNumber" readonly value="<%= typeof purchaseNumber !== 'undefined' ? purchaseNumber : '' %>" placeholder="Assigned when saved"></label>
    <label>Date *<input name="purchaseDate" type="date" required value="<%= dateInput() %>"></label>
    <label>Customer name *<input name="customerName" id="urdCustomerName" data-urd-customer-name autocomplete="off" required placeholder="Search or enter customer"></label>
    <label>Mobile number<input name="customerPhone" id="urdCustomerPhone" inputmode="numeric" maxlength="15" placeholder="Optional"></label>
    <label>Find existing customer<input id="urdCustomerSearch" type="search" autocomplete="off" placeholder="Search by name or mobile…"></label>
    <label>Existing customer<select name="customerId" id="urdCustomer"><option value="">New customer / choose from search</option><% customers.forEach(c => { %><option value="<%= c.id %>" data-customer-name="<%= c.name %>" data-customer-phone="<%= c.phone || '' %>" data-customer-address="<%= c.address || '' %>" data-customer-pan="<%= c.panNumber || '' %>"><%= c.name %><%= c.phone ? ` · ${c.phone}` : '' %></option><% }); %></select></label>
    <label>Metal *<select name="metal" data-urd-metal><option value="GOLD" selected>Gold</option><option value="SILVER">Silver</option><option value="PLATINUM">Platinum</option><option value="OTHER">Other</option></select></label>
  </div></section>
  <section class="form-section"><h2>Weight &amp; rate</h2><div class="form-grid four">
    <label>Purity
      <input name="purity" data-urd-purity maxlength="50" placeholder="e.g. 22K, 24K, 925, 99.9">
    </label>
    <label>Gross weight (g)<input name="grossWeight" type="number" step="0.001" min="0" placeholder="0.000" data-urd-gross></label>
    <label>Net weight (g) *<input name="netWeight" type="number" step="0.001" min="0.001" required placeholder="0.000" data-urd-net></label>
    <label>Rate / gram (₹) *<input name="ratePerGram" type="number" step="0.01" min="0.01" required placeholder="0.00" data-urd-rate data-rate-22="<%= rateInfo.rate ? Number(rateInfo.rate.gold22k) : 0 %>" data-rate-24="<%= rateInfo.rate ? Number(rateInfo.rate.gold24k) : 0 %>" data-rate-silver="<%= rateInfo.rate ? Number(rateInfo.rate.silver) : 0 %>"></label>
  </div></section>
  <section class="form-section"><h2>Valuation &amp; payout</h2><div class="form-grid four">
    <div class="rate-readout accent"><span>Valuation amount</span><strong data-urd-total>₹0.00</strong><small>Net weight × rate</small></div>
    <label>Valuation amount (₹) *<input name="totalAmount" type="number" step="0.01" min="0.01" required placeholder="0.00" data-urd-amount></label>
    <label>Amount paid to customer (₹) *<input name="paid" type="number" step="0.01" min="0" required placeholder="0.00" data-urd-paid></label>
    <label>Payout method<select name="paymentMethod" data-payment-method><option value="CASH">Cash</option><option value="UPI">UPI</option><option value="CARD">Card</option><option value="BANK_TRANSFER">Bank Transfer</option></select></label>
  </div></section>
  <section class="form-section"><label>Description<textarea name="description" rows="2" placeholder="Item description — old bangles, broken chain, etc."></textarea></label><label>Notes<textarea name="notes" rows="2" placeholder="Customer ID proof, any deductions, etc."></textarea></label></section>
  <footer class="form-footer"><a class="button ghost" href="/urd-purchases">Cancel</a><button class="button" type="submit">Save URD purchase</button></footer>
</form>
<script>
(function() {
  const form = document.querySelector('[data-urd-form]'); if (!form) return;
  const rateInput = form.querySelector('[data-urd-rate]'), netInput = form.querySelector('[data-urd-net]'), grossInput = form.querySelector('[data-urd-gross]'), amountInput = form.querySelector('[data-urd-amount]'), paidInput = form.querySelector('[data-urd-paid]'), totalDisplay = form.querySelector('[data-urd-total]'), metalSel = form.querySelector('[data-urd-metal]'), purityInput = form.querySelector('[data-urd-purity]');
  let payoutEdited = false;
  function recalc() { const total = (parseFloat(netInput.value) || 0) * (parseFloat(rateInput.value) || 0); amountInput.value = total.toFixed(2); if (!payoutEdited) paidInput.value = total.toFixed(2); totalDisplay.textContent = '₹' + total.toLocaleString('en-IN', { minimumFractionDigits: 2 }); }
  function updateRate() {
    const purity = String(purityInput?.value || '').trim().toUpperCase();
    const rate = metalSel.value === 'SILVER' ? Number(rateInput.dataset.rateSilver)
      : purity === '24K' ? Number(rateInput.dataset.rate24)
        : Number(rateInput.dataset.rate22);
    if (rate > 0) rateInput.value = rate.toFixed(2);
    recalc();
  }
  grossInput.addEventListener('input', () => { netInput.value = grossInput.value; recalc(); }); netInput.addEventListener('input', recalc); rateInput.addEventListener('input', recalc); paidInput.addEventListener('input', () => { payoutEdited = true; }); purityInput?.addEventListener('input', updateRate); metalSel.addEventListener('change', updateRate); updateRate();

  const customerName = document.getElementById('urdCustomerName');
  const customerPhone = document.getElementById('urdCustomerPhone');
  const customerSearch = document.getElementById('urdCustomerSearch');
  const customerSelect = document.getElementById('urdCustomer');
  let customerTimer, customerController, phoneTimer, phoneController;
  function applyCustomer(customer) {
    if (!customer) return;
    customerName.value = customer.name || '';
    customerPhone.value = customer.phone || '';
    customerSelect.value = String(customer.id || '');
    if (customerSelect.value !== String(customer.id || '')) {
      const option = document.createElement('option');
      option.value = String(customer.id); option.textContent = `${customer.name}${customer.phone ? ` · ${customer.phone}` : ''}`;
      customerSelect.appendChild(option); customerSelect.value = option.value;
    }
  }
  async function lookupCustomerByPhone() {
    const phone = String(customerPhone?.value || '').replace(/\D/g, '').slice(0, 15);
    if (customerPhone) customerPhone.value = phone;
    if (!phone || phone.length < 10) { if (customerSelect) customerSelect.value = ''; return; }
    phoneController?.abort(); phoneController = new AbortController();
    try {
      const response = await fetch('/api/customers/phone/' + encodeURIComponent(phone), { signal: phoneController.signal });
      const data = await response.json();
      if (!response.ok) throw new Error(data.error || 'Could not look up this customer.');
      if (data.found) applyCustomer(data.customer); else if (customerSelect) customerSelect.value = '';
    } catch (error) { if (error.name !== 'AbortError' && customerSelect) customerSelect.value = ''; }
  }
  customerPhone?.addEventListener('input', () => {
    if (customerSelect) customerSelect.value = '';
    clearTimeout(phoneTimer);
    const digits = String(customerPhone.value || '').replace(/\D/g, '');
    if (digits.length >= 10) phoneTimer = setTimeout(lookupCustomerByPhone, 300);
  });
  customerPhone?.addEventListener('blur', lookupCustomerByPhone);
  customerPhone?.addEventListener('keydown', async (event) => {
    if (event.key !== 'Enter' || event.isComposing) return;
    event.preventDefault(); clearTimeout(phoneTimer); await lookupCustomerByPhone(); customerName?.focus();
  });
  customerName?.addEventListener('input', () => { if (customerSelect) customerSelect.value = ''; });
  customerSelect?.addEventListener('change', () => {
    const option = customerSelect.selectedOptions[0];
    if (!option) return;
    if (option.dataset.customer) {
      try { applyCustomer(JSON.parse(option.dataset.customer)); } catch (_) { /* the selected id is still submitted */ }
    } else if (option.dataset.customerName) {
      applyCustomer({ id: option.value, name: option.dataset.customerName, phone: option.dataset.customerPhone, address: option.dataset.customerAddress, panNumber: option.dataset.customerPan });
    }
  });
  if (customerSearch && customerSelect) {
    const blankOption = () => { const option = document.createElement('option'); option.value = ''; option.textContent = 'New customer / choose from search'; return option; };
    customerSearch.addEventListener('input', () => {
      clearTimeout(customerTimer);
      const query = customerSearch.value.trim();
      if (query.length < 2) { customerSelect.replaceChildren(blankOption()); return; }
      customerTimer = setTimeout(async () => {
        customerController?.abort(); customerController = new AbortController();
        try {
          const response = await fetch(`/api/customers/search?q=${encodeURIComponent(query)}`, { signal: customerController.signal });
          const data = await response.json();
          if (!response.ok) throw new Error(data.error || 'Could not search customers.');
          const options = (data.customers || []).map((customer) => { const option = document.createElement('option'); option.value = String(customer.id); option.textContent = `${customer.name}${customer.phone ? ` · ${customer.phone}` : ''}`; option.dataset.customer = JSON.stringify(customer); return option; });
          customerSelect.replaceChildren(blankOption(), ...options);
          if (options.length === 1) { customerSelect.value = options[0].value; applyCustomer(JSON.parse(options[0].dataset.customer)); }
        } catch (error) { if (error.name !== 'AbortError') customerSelect.replaceChildren(blankOption()); }
      }, 180);
    });
  }
})();
</script>
