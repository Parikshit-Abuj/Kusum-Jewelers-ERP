<header class="page-header">
  <div>
    <p class="eyebrow">Old gold / silver buying</p>
    <h1>URD Purchases</h1>
    <p class="muted">Track metal purchased from walk-in and regular customers.</p>
  </div>
  <div class="header-actions"><a class="button ghost" href="/data-management?resource=urd">Export / archive</a><a class="button" href="/urd-purchases/new">+ New purchase</a></div>
</header>

<% const qVal = typeof q !== 'undefined' ? q : ''; const purchaseList = typeof purchases !== 'undefined' && Array.isArray(purchases) ? purchases : []; %>
<section class="panel">
  <form class="search-bar" method="get" action="/urd-purchases">
    <input name="q" value="<%= qVal %>" placeholder="Search by customer name, mobile number or URD no.">
    <button class="button secondary" type="submit">Search</button>
    <% if (qVal) { %><a class="button ghost" href="/urd-purchases">Clear</a><% } %>
  </form>

  <% if (qVal) { %>
    <p class="filter-result-count"><strong><%= purchaseList.length %></strong> purchase<%= purchaseList.length === 1 ? '' : 's' %> found</p>
  <% } %>

  <% if (purchaseList.length) { %>
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>URD No.</th>
          <th>Date</th>
          <th>Customer</th>
          <th>Metal</th>
          <th>Purity</th>
          <th class="right">Weight (g)</th>
          <th class="right">Rate / g</th>
          <th class="right">Valuation</th>
          <th class="right">Payout</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% purchaseList.forEach(p => { %>
        <tr>
          <td><strong><%= p.purchaseNumber %></strong></td>
          <td><%= p.purchaseDate.toLocaleDateString('en-IN', { dateStyle: 'medium' }) %></td>
          <td>
            <a href="/customers/<%= p.customer.id %>"><%= p.customer.name %></a>
            <% if (p.customer.phone) { %><small><%= p.customer.phone %></small><% } %>
          </td>
          <td><%= p.metal %></td>
          <td><%= p.purity || '—' %></td>
          <td class="right"><%= Number(p.netWeight).toFixed(3) %></td>
          <td class="right"><%- money(p.ratePerGram) %></td>
          <td class="right"><strong><%- money(p.totalAmount) %></strong><% if (Number(p.saleOffset) > 0) { %><small>Settled: <%- money(p.saleOffset) %></small><% } %></td>
          <td class="right"><strong><%- money(p.paid) %></strong><small><%= p.paymentMethod.replace('_', ' ') %></small></td>
          <td class="actions">
            <a class="button ghost small" href="/urd-purchases/<%= p.id %>/invoice.pdf" target="_blank">PDF</a>
            <form method="post" action="/urd-purchases/<%= p.id %>/delete" onsubmit="return confirm('Delete this URD entry?')">
              <button class="icon-button" type="submit" title="Delete" style="color:#b53d36">✕</button>
            </form>
          </td>
        </tr>
        <% if (p.description) { %>
        <tr class="sub-row"><td colspan="10"><small><%= p.description %></small></td></tr>
        <% } %>
        <% const urdDue = Math.max(0, Number(p.totalAmount) - Number(p.saleOffset) - Number(p.paid)); if (urdDue > 0) { %>
        <tr class="sub-row">
          <td colspan="10">
            <form method="post" action="/urd-purchases/<%= p.id %>/payments" class="search-bar" style="margin:0;align-items:end">
              <strong style="white-space:nowrap">Due: <%- money(urdDue) %></strong>
              <label style="margin:0">Pay now<input name="amount" type="number" min="0.01" max="<%= urdDue.toFixed(2) %>" step="0.01" required value="<%= urdDue.toFixed(2) %>"></label>
              <label style="margin:0">Method<select name="paymentMethod" data-payment-method><option value="CASH">Cash</option><option value="UPI">UPI</option><option value="CARD">Card</option><option value="BANK_TRANSFER">Bank Transfer</option></select></label>
              <input name="entryDate" type="hidden" value="<%= dateInput() %>">
              <button class="button secondary small" type="submit">Record payout</button>
            </form>
          </td>
        </tr>
        <% } %>
        <% }); %>
      </tbody>
    </table>
  </div>
  <% } else { %>
    <% if (qVal) { %>
    <div class="empty-state compact">
      <span>🔍</span>
      <h3>No URD purchases match your search</h3>
      <p>Try a different customer name, mobile number or URD number.</p>
      <a class="button" href="/urd-purchases">Clear search</a>
    </div>
    <% } else { %>
    <div class="empty-state">
      <span>⇣</span>
      <h3>No URD purchases yet</h3>
      <p>When you buy old gold or silver from a customer, log it here and print its tax invoice when needed.</p>
      <a class="button" href="/urd-purchases/new">Record first purchase</a>
    </div>
    <% } %>
  <% } %>
</section>
