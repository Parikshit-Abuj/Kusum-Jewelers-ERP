generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum MetalType {
  GOLD
  SILVER
  PLATINUM
  DIAMOND
  OTHER
}

enum ProductStatus {
  AVAILABLE
  SOLD_OUT
  INACTIVE
}

enum MovementType {
  OPENING
  SALE
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
}

enum PaymentMethod {
  CASH
  UPI
  CARD
  BANK_TRANSFER
  CREDIT
  MIXED
}

enum MakingChargeType {
  FIXED
  PER_GRAM
  PERCENTAGE
}

enum LedgerEntryType {
  SALE_CREDIT
  PAYMENT_RECEIVED
  ADJUSTMENT
}

enum CashbookType {
  IN
  OUT
}

model Customer {
  id            Int              @id @default(autoincrement())
  name          String
  phone         String?          @unique
  email         String?
  address       String?          @db.Text
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  sales         Sale[]
  ledger        CustomerLedger[]
  urdPurchases  UrdPurchase[]
  cashbookEntries CashbookEntry[]
}

model Product {
  id                  Int           @id @default(autoincrement())
  barcode             String?       @unique
  sku                 String        @unique
  name                String
  category            String
  metal               MetalType     @default(GOLD)
  purity              String?
  grossWeight         Decimal       @default(0) @db.Decimal(12, 3)
  stoneWeight         Decimal       @default(0) @db.Decimal(12, 3)
  netWeight           Decimal       @default(0) @db.Decimal(12, 3)
  quantity            Int           @default(0)
  reorderLevel        Int           @default(1)
  purchasePrice       Decimal       @default(0) @db.Decimal(12, 2)
  sellingPrice        Decimal       @default(0) @db.Decimal(12, 2)
  makingChargePerGram Decimal       @default(0) @db.Decimal(12, 2)
  makingChargeType    MakingChargeType @default(PER_GRAM)
  makingChargeValue   Decimal       @default(0) @db.Decimal(12, 2)
  location            String?
  batchDocNo          String?
  notes               String?       @db.Text
  status              ProductStatus @default(AVAILABLE)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  saleItems           SaleItem[]
  movements           StockMovement[]

  @@index([batchDocNo])
}

model StockMovement {
  id        Int          @id @default(autoincrement())
  productId Int
  type      MovementType
  quantity  Int
  note      String?
  createdAt DateTime     @default(now())
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, createdAt])
}

model Sale {
  id            Int           @id @default(autoincrement())
  invoiceNumber String        @unique
  customerId    Int?
  saleDate      DateTime      @default(now())
  subtotal      Decimal       @default(0) @db.Decimal(12, 2)
  discount      Decimal       @default(0) @db.Decimal(12, 2)
  gstRate       Decimal       @default(3) @db.Decimal(5, 2)
  gstAmount     Decimal       @default(0) @db.Decimal(12, 2)
  total         Decimal       @default(0) @db.Decimal(12, 2)
  urdOffset     Decimal       @default(0) @db.Decimal(12, 2)
  paid          Decimal       @default(0) @db.Decimal(12, 2)
  cashPaid      Decimal       @default(0) @db.Decimal(12, 2)
  upiPaid       Decimal       @default(0) @db.Decimal(12, 2)
  balance       Decimal       @default(0) @db.Decimal(12, 2)
  paymentMethod PaymentMethod @default(CASH)
  notes         String?       @db.Text
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  customer      Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items         SaleItem[]
  ledgerEntries CustomerLedger[]
  urdPurchase  UrdPurchase?

  @@index([saleDate])
}

model SaleItem {
  id          Int     @id @default(autoincrement())
  saleId      Int
  productId   Int?
  productBarcode String?
  productSku  String  @default("")
  productName String  @default("")
  productMetal MetalType?
  productPurity String?
  grossWeight Decimal @default(0) @db.Decimal(12, 3)
  quantity    Int
  weight      Decimal @default(0) @db.Decimal(12, 3)
  unitPrice   Decimal @db.Decimal(12, 2)
  metalRate   Decimal @default(0) @db.Decimal(12, 2)
  metalAmount Decimal @default(0) @db.Decimal(12, 2)
  makingCharge Decimal @default(0) @db.Decimal(12, 2)
  makingChargeType MakingChargeType @default(PER_GRAM)
  makingChargeValue Decimal @default(0) @db.Decimal(12, 2)
  taxableAmount Decimal @default(0) @db.Decimal(12, 2)
  lineTotal   Decimal @db.Decimal(12, 2)
  sale        Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
}

model DailyRate {
  id        Int      @id @default(autoincrement())
  rateDate  String   @unique @db.VarChar(10)
  gold22k   Decimal  @default(0) @db.Decimal(12, 2)
  gold24k   Decimal  @default(0) @db.Decimal(12, 2)
  silver    Decimal  @default(0) @db.Decimal(12, 2)
  note      String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BarcodeSequence {
  prefix      String   @id @db.VarChar(12)
  lastNumber  Int      @default(0)
  updatedAt   DateTime @updatedAt
}

model CustomerLedger {
  id            Int             @id @default(autoincrement())
  customerId    Int
  saleId        Int?
  type          LedgerEntryType
  amount        Decimal         @db.Decimal(12, 2)
  paymentMethod PaymentMethod?
  reference     String?
  note          String?         @db.Text
  createdAt     DateTime        @default(now())
  customer      Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  sale          Sale?           @relation(fields: [saleId], references: [id], onDelete: SetNull)

  @@index([customerId, createdAt])
  @@index([saleId])
}

model CashbookEntry {
  id            Int            @id @default(autoincrement())
  entryDate     String         @db.VarChar(10)
  type          CashbookType
  paymentMethod PaymentMethod
  description   String         @db.VarChar(255)
  amount        Decimal        @db.Decimal(12, 2)
  reference     String?        @db.VarChar(100)
  notes         String?        @db.Text
  customerId    Int?
  syncLedger    Boolean        @default(false)
  createdAt     DateTime       @default(now())
  customer      Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([entryDate])
  @@index([customerId])
}

model UrdPurchase {
  id              Int           @id @default(autoincrement())
  purchaseNumber  String        @unique
  customerId      Int
  purchaseDate    DateTime      @default(now())
  metal           MetalType     @default(GOLD)
  purity          String?
  grossWeight     Decimal       @default(0) @db.Decimal(12, 3)
  netWeight       Decimal       @default(0) @db.Decimal(12, 3)
  ratePerGram     Decimal       @default(0) @db.Decimal(12, 2)
  totalAmount     Decimal       @default(0) @db.Decimal(12, 2)
  saleOffset      Decimal       @default(0) @db.Decimal(12, 2)
  paid            Decimal       @default(0) @db.Decimal(12, 2)
  paymentMethod   PaymentMethod @default(CASH)
  description     String?       @db.Text
  notes           String?       @db.Text
  saleId          Int?          @unique
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  customer        Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  sale            Sale?         @relation(fields: [saleId], references: [id], onDelete: SetNull)

  @@index([purchaseDate])
  @@index([customerId])
}

model DocumentSequence {
  key        String   @id @db.VarChar(32)
  lastNumber Int      @default(0)
  updatedAt  DateTime @updatedAt
}

model ItemName {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(255)
  category  String   @db.VarChar(100)
  createdAt DateTime @default(now())
}
