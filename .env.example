# Create .env from this file and provide your local MySQL connection string.
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/kusum_erp"
PORT=3000
AUTH_USERNAME=kusum
# Fresh desktop setup writes AUTH_PASSWORD_HASH automatically. AUTH_PASSWORD is
# accepted only for an older/manual development configuration and is upgraded
# to a salted hash after the first successful sign-in.
AUTH_PASSWORD=choose-your-own-password
SESSION_SECRET=replace-with-a-long-random-value
TSC_PRINTER_NAME=TSC TTP-244 Pro
TSC_PRINTER_MODE=WINDOWS
TSC_PRINTER_HOST=
TSC_PRINTER_PORT=9100
